<Window x:Class="EtherEditorNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ether Editor" Height="850" Width="1280" MinWidth="1000" MinHeight="700"
        Background="#0f1115" WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Background="#0f1115">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- DISCORD-STYLE SLIM WPF TITLEBAR WITH CENTERED NAVIGATION TABS (34PX) -->
        <Grid Grid.Row="0" Background="#111214">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- APP LOGO & TITLE ("Ether Editor") ON FAR LEFT -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                <Border Width="18" Height="18" CornerRadius="5" Background="#5865F2">
                    <TextBlock Text="E" Foreground="White" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Ether Editor" Foreground="#F2F3F5" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- CENTERED NAVIGATION TAB BUTTONS -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnTabHome" Click="BtnTabHome_Click" Style="{StaticResource WinTabBtn}" Tag="Active" Margin="0,0,6,0" ToolTip="Trang chủ">
                    <TextBlock Text="🏠" FontSize="12"/>
                </Button>
                <Button x:Name="BtnTabTranslate" Click="BtnTabTranslate_Click" Style="{StaticResource WinTabBtn}" ToolTip="Dịch thuật">
                    <TextBlock Text="🌐" FontSize="12"/>
                </Button>
            </StackPanel>

            <!-- WINDOW CONTROL BUTTONS ON FAR RIGHT -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="BtnMinimize_Click" Style="{StaticResource WinControlBtn}" Content="&#xE921;" ToolTip="Thu nhỏ"/>
                <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource WinControlBtn}" Content="&#xE922;" ToolTip="Phóng to"/>
                <Button Click="BtnClose_Click" Style="{StaticResource WinCloseBtn}" Content="&#xE8BB;" ToolTip="Đóng"/>
            </StackPanel>
        </Grid>

        <!-- MAIN NATIVE WPF CONTENT AREA (NO BROWSER / NO WEBVIEW2) -->
        <ContentControl x:Name="MainContentArea" Grid.Row="1"/>
    </Grid>
</Window>
