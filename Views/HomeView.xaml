<UserControl x:Class="EtherEditorNative.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0d0e12">
    <UserControl.Resources>
        <!-- SOLID DARK CARD STYLE (STRICT MATCH WITH PYTHON #111418) -->
        <Style x:Key="SolidCard" TargetType="Border">
            <Setter Property="Background" Value="#111418"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#1e293b"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ACTION ICON BUTTON (32x32) WITH HOVER ANIMATION -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="#1e212b"/>
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2d3142"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3b82f6"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60a5fa"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODAL FOOTER BUTTON WITH ANIMATED HOVER -->
        <Style x:Key="ModalFooterBtn" TargetType="Button">
            <Setter Property="Background" Value="#14161f"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="BorderBrush" Value="#2d3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222734"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODAL PRIMARY BUTTON WITH ANIMATED HOVER -->
        <Style x:Key="ModalPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#60a5fa"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#93c5fd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PURE DARK COMBOBOX TOGGLE BUTTON TEMPLATE -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#3b82f6"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#3b82f6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- PURE DARK COMBOBOX TEMPLATE (NEVER WHITE POPUP) -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#181a20"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#2d3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid">
                            <ToggleButton x:Name="toggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            
                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}" 
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" 
                                        Background="#14161f" 
                                        BorderBrush="#2d3142" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Margin="0,4,0,0" 
                                        MinWidth="{Binding ActualWidth, ElementName=mainGrid}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Background="#14161f" Foreground="#f1f5f9">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3b82f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DARK COMBOBOX ITEM STYLE -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#14161f"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2563eb"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainRootGrid">
        <!-- BACKGROUND WALLPAPER WITH BLUR OVERLAY (MATCHING PYTHON .home-bg-overlay) -->
        <Grid>
            <Image x:Name="ImgBgWallpaper" Stretch="UniformToFill" Opacity="0.22"/>
            <Border Background="#0b0c10" Opacity="0.88"/>
        </Grid>

        <!-- MAIN SCROLLABLE WRAPPER -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,40,20,20">
            <!-- 55% LEFT COLUMN - 45% RIGHT COLUMN GRID -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55*"/>
                    <ColumnDefinition Width="45*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN (55%) ================= -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    
                    <!-- SECTION 1: DỰ ÁN HIỆN TẠI (POSTER GRID 220x380) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <TextBlock Text="DỰ ÁN HIỆN TẠI" Style="{StaticResource SectionLabel}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- GENSHIN POSTER CARD (220x380) -->
                        <Border Grid.Column="0" Width="220" Height="380" Background="#111418" CornerRadius="4" BorderBrush="#1e293b" BorderThickness="1" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonDown="GameCard_Click" Tag="genshin">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransGenshin" Y="0"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TransGenshin" Storyboard.TargetProperty="Y" To="-8" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TransGenshin" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- CARD IMAGE WRAPPER -->
                                <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True" Background="#0f1115" BorderBrush="#1e293b" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="ImgCardGenshin" Stretch="UniformToFill"/>
                                        <!-- CARD STATUS BANNER (TOP GRADIENT) -->
                                        <Border VerticalAlignment="Top" Height="80">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#a0000000" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="v---" Foreground="White" FontSize="20" FontWeight="Black" Margin="15,12,0,0"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- CARD TITLE ROW -->
                                <Border Grid.Row="1" Padding="8,10,8,4">
                                    <StackPanel>
                                        <TextBlock Text="Genshin Impact" Foreground="#f1f5f9" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Chưa tải" Foreground="#eab308" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- HSR POSTER CARD (ACTIVE SELECTED) -->
                        <Border Grid.Column="1" Width="220" Height="380" Background="#111418" CornerRadius="4" BorderBrush="#3b82f6" BorderThickness="2" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="GameCard_Click" Tag="hsr">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransHsr" Y="0"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TransHsr" Storyboard.TargetProperty="Y" To="-8" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TransHsr" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- CARD IMAGE WRAPPER -->
                                <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True" Background="#0f1115" BorderBrush="#1e293b" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="ImgCardHsr" Stretch="UniformToFill"/>
                                        <!-- CARD STATUS BANNER (TOP GRADIENT) -->
                                        <Border VerticalAlignment="Top" Height="80">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#a0000000" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="v4.4" Foreground="White" FontSize="20" FontWeight="Black" Margin="15,12,0,0"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- CARD TITLE ROW -->
                                <Border Grid.Row="1" Padding="8,10,8,4">
                                    <StackPanel>
                                        <TextBlock Text="Honkai: Star Rail" Foreground="#f1f5f9" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Sẵn sàng" Foreground="#22c55e" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ZZZ POSTER CARD (220x380) -->
                        <Border Grid.Column="2" Width="220" Height="380" Background="#111418" CornerRadius="4" BorderBrush="#1e293b" BorderThickness="1" HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="GameCard_Click" Tag="zzz">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransZzz" Y="0"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TransZzz" Storyboard.TargetProperty="Y" To="-8" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TransZzz" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- CARD IMAGE WRAPPER -->
                                <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True" Background="#0f1115" BorderBrush="#1e293b" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="ImgCardZzz" Stretch="UniformToFill"/>
                                        <!-- CARD STATUS BANNER (TOP GRADIENT) -->
                                        <Border VerticalAlignment="Top" Height="80">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#a0000000" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="v---" Foreground="White" FontSize="20" FontWeight="Black" Margin="15,12,0,0"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- CARD TITLE ROW -->
                                <Border Grid.Row="1" Padding="8,10,8,4">
                                    <StackPanel>
                                        <TextBlock Text="Zenless Zone Zero" Foreground="#f1f5f9" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Chưa tải" Foreground="#eab308" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SECTION 2: QUẢN LÝ DỮ LIỆU -->
                    <TextBlock Text="QUẢN LÝ DỮ LIỆU" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource SolidCard}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ASSETS TABLE HEADER -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TÊN TỆP" Foreground="#72798e" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="DUNG LƯỢNG" Foreground="#72798e" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="PHIÊN BẢN" Foreground="#72798e" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="TRẠNG THÁI" Foreground="#72798e" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="4" Text="HÀNH ĐỘNG" Foreground="#72798e" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Grid.Row="1" Background="#1e293b" Margin="0,0,0,12"/>

                            <!-- ASSETS LIST -->
                            <StackPanel Grid.Row="2">
                                <!-- GENSHIN ASSET ROW -->
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📄 " FontSize="12"/>
                                        <TextBlock Text="genshin.json" Foreground="#f1f5f9" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="-- MB" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#1c2234" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="v---" Foreground="#6b7280" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="3" Background="#261d10" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Chưa tải" Foreground="#eab308" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconBtn}" Content="📥" ToolTip="Tải về" Click="BtnOpenAddProject_Click" Tag="genshin"/>
                                        <Button Style="{StaticResource IconBtn}" Content="🗑️" ToolTip="Xóa" Click="BtnDeleteAsset_Click" Tag="genshin"/>
                                    </StackPanel>
                                </Grid>

                                <!-- HSR ASSET ROW -->
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📄 " FontSize="12"/>
                                        <TextBlock Text="hsr.json" Foreground="#f1f5f9" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="169.6 MB" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#1c2234" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="v4.4" Foreground="#38bdf8" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="3" Background="#10281b" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Sẵn sàng" Foreground="#22c55e" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconBtn}" Content="✔" Foreground="#22c55e" ToolTip="Đã cài"/>
                                        <Button Style="{StaticResource IconBtn}" Content="🗑️" ToolTip="Xóa" Click="BtnDeleteAsset_Click" Tag="hsr"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ZZZ ASSET ROW -->
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📄 " FontSize="12"/>
                                        <TextBlock Text="zzz.json" Foreground="#f1f5f9" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="-- MB" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#1c2234" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="v---" Foreground="#6b7280" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="3" Background="#261d10" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Chưa tải" Foreground="#eab308" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconBtn}" Content="📥" ToolTip="Tải về" Click="BtnOpenAddProject_Click" Tag="zzz"/>
                                        <Button Style="{StaticResource IconBtn}" Content="🗑️" ToolTip="Xóa" Click="BtnDeleteAsset_Click" Tag="zzz"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ================= RIGHT COLUMN (45%) ================= -->
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="HOẠT ĐỘNG GẦN ĐÂY" Style="{StaticResource SectionLabel}"/>

                    <!-- RECENT TABLE SOLID (STRICT HEIGHT 869px MATCHING PYTHON .recent-table-solid) -->
                    <Border Style="{StaticResource SolidCard}" Height="869" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TABLE HEADER (STRICT RATIO: 55px | 2.5fr | 1fr | 120px | 80px) -->
                            <Border Grid.Row="0" Background="#0a0c0e" BorderBrush="#1e293b" BorderThickness="0,0,0,1" Padding="12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LOẠI" Foreground="#cbd5e1" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="1" Text="TÊN TỆP" Foreground="#cbd5e1" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="2" Text="DỰ ÁN" Foreground="#cbd5e1" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="3" Text="SỬA ĐỔI" Foreground="#cbd5e1" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="4" Text="HÀNH ĐỘNG" Foreground="#cbd5e1" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- LISTVIEW FOR RECENT FILES -->
                            <ListView x:Name="LvRecentFiles" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#d1d5db" FontSize="13" Padding="8" MouseDoubleClick="LvRecentFiles_MouseDoubleClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="rowBorder" Background="#161a22" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="rowBorder" Property="Background" Value="#222734"/>
                                                            <Setter TargetName="rowBorder" Property="BorderBrush" Value="#3b82f6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- LOẠI PILL BADGE -->
                                            <Border Grid.Column="0" Background="#14532d" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type}" Foreground="#4ade80" FontSize="11" FontWeight="Bold"/>
                                            </Border>

                                            <!-- TÊN TỆP -->
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#f1f5f9" FontWeight="Medium" VerticalAlignment="Center"/>

                                            <!-- DỰ ÁN -->
                                            <TextBlock Grid.Column="2" Text="{Binding Project}" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                            <!-- SỬA ĐỔI -->
                                            <TextBlock Grid.Column="3" Text="{Binding ModifiedTime}" Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>

                                            <!-- HÀNH ĐỘNG -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource IconBtn}" Content="✏️" ToolTip="Chỉnh sửa" Click="BtnEditRecent_Click" Tag="{Binding Path}"/>
                                                <Button Style="{StaticResource IconBtn}" Content="🗑️" ToolTip="Xóa" Click="BtnDeleteRecent_Click" Tag="{Binding Path}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- DOWNLOAD PROJECT MODAL (COMPACT SLEEK LAYOUT WITH PURE DARK COMBOBOX) -->
        <Border x:Name="AddProjectModalOverlay" Visibility="Collapsed" Background="#c0000000">
            <Border Style="{StaticResource SolidCard}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0" Background="#1a1d23" Padding="20,14" BorderBrush="#1e293b" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="☁️ " FontSize="14"/>
                                <TextBlock x:Name="TxtModalGameTitle" Text="TẢI DỰ ÁN ZENLESS ZONE ZERO" Foreground="White" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <Button Content="✕" Foreground="#9ca3af" Background="Transparent" BorderThickness="0" FontSize="16" HorizontalAlignment="Right" Cursor="Hand" Click="CloseAddProjectModal_Click"/>
                        </Grid>
                    </Border>

                    <!-- BODY -->
                    <Border Grid.Row="1" Padding="20,16,20,12">
                        <StackPanel>
                            <TextBlock Text="CHỌN NGUỒN TẢI (DOWNLOAD SOURCE):" Foreground="#94a3b8" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                            
                            <!-- PURE DARK COMBOBOX (USING DarkComboBoxStyle) -->
                            <ComboBox x:Name="CboDownloadSource" Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="0" Margin="0,0,0,8">
                                <ComboBoxItem Content="GitLab (AnimeGameData - Mặc định)"/>
                                <ComboBoxItem Content="Saccharose Wiki (Dynamic API - Khuyên dùng)"/>
                                <ComboBoxItem Content="Chạy thử (Mock Download - Không cần mạng)"/>
                            </ComboBox>

                            <!-- DYNAMIC PROGRESS AREA (HIDDEN UNTIL CLICKING TẢI VỀ) -->
                            <StackPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="0,8,0,4">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtProgressStatus" Text="KHỞI ĐỘNG TẢI..." Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtProgressPercent" Text="0%" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PbOverall" Value="0" Height="4" Background="#0f172a" Foreground="#3b82f6" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- FOOTER WITH ANIMATED HOVER BUTTONS -->
                    <Border Grid.Row="2" Background="#14161f" Padding="20,12" BorderBrush="#1e293b" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- LEFT: DỪNG LẠI (HEIGHT 42 & HOVER EFFECT) -->
                            <Button Grid.Column="0" x:Name="BtnStopDownload" Style="{StaticResource ModalFooterBtn}" Content="DỪNG LẠI" Margin="0,0,8,0" Click="CloseAddProjectModal_Click"/>

                            <!-- RIGHT: TẢI VỀ / ĐANG TẢI... (HEIGHT 42 & HOVER EFFECT) -->
                            <Button Grid.Column="1" x:Name="BtnConfirmDownload" Style="{StaticResource ModalPrimaryBtn}" Content="TẢI VỀ" Margin="8,0,0,0" Click="StartDownloadFromModal_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
