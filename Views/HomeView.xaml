<UserControl x:Class="EtherEditorNative.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0b0c10">
    <UserControl.Resources>
        <!-- SOLID DARK DASHBOARD CARD STYLE (STRICT MATCH WITH USER UI SCREENSHOT) -->
        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="#12141c"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#1e2230"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- STEAM/HOYOLAB STYLE HERO BANNER GAME CARD (DYNAMICALLY STRETCHES IN 4/6 SPLIT) -->
        <Style x:Key="HeroBannerGameCard" TargetType="Border">
            <Setter Property="Background" Value="#181b26"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#252a3b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202535"/>
                    <Setter Property="BorderBrush" Value="#3b82f6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- FLOATING GLASS ACTION BUTTONS FOR HERO BANNER CARDS (28x28) -->
        <Style x:Key="FloatingGlassBtn" TargetType="Button">
            <Setter Property="Background" Value="#a0141824"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#40ffffff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3b82f6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60a5fa"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FloatingGlassDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#a0291215"/>
            <Setter Property="Foreground" Value="#f87171"/>
            <Setter Property="BorderBrush" Value="#60ef4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ef4444"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#fca5a5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACTION ICON BUTTON (30x30) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="#1e2230"/>
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2d3345"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3b82f6"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60a5fa"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PURE DARK COMBOBOX TOGGLE BUTTON TEMPLATE -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#3b82f6"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#3b82f6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- PURE DARK COMBOBOX TEMPLATE -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#181a20"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#2d3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid">
                            <ToggleButton x:Name="toggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            
                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}" 
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" 
                                        Background="#14161f" 
                                        BorderBrush="#2d3142" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Margin="0,4,0,0" 
                                        MinWidth="{Binding ActualWidth, ElementName=mainGrid}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Background="#14161f" Foreground="#f1f5f9">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3b82f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DARK COMBOBOX ITEM STYLE -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#14161f"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2563eb"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODAL FOOTER BUTTON WITH ANIMATED HOVER -->
        <Style x:Key="ModalFooterBtn" TargetType="Button">
            <Setter Property="Background" Value="#14161f"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="BorderBrush" Value="#2d3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222734"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODAL PRIMARY BUTTON WITH ANIMATED HOVER -->
        <Style x:Key="ModalPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#60a5fa"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#93c5fd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainRootGrid">
        <!-- BACKGROUND WALLPAPER WITH OVERLAY -->
        <Grid>
            <Image x:Name="ImgBgWallpaper" Stretch="UniformToFill" Opacity="0.18"/>
            <Border Background="#0b0c10" Opacity="0.92"/>
        </Grid>

        <!-- MAIN DASHBOARD (PERFECT 4/6 HEIGHT RATIO SPLIT) -->
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="6*"/>
            </Grid.RowDefinitions>

            <!-- ================= TOP ROW (ROW 0: 40% VIEWPORT HEIGHT) ================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="38*"/>
                </Grid.ColumnDefinitions>

                <!-- QUADRANT 1 (TOP-LEFT): PROJECT WORKSPACES (40% ROW HEIGHT SPLIT) -->
                <Border Grid.Column="0" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER WITH VIBRANT VECTOR FOLDER ICON -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#3b82f6" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dự Án Game Dịch Thuật" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#1c202d" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="3 Dự án khả dụng" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- 3 STEAM/HOYOLAB HERO BANNER CARDS GRID (DYNAMICALLY STRETCHES IN 40% ROW HEIGHT) -->
                        <UniformGrid Grid.Row="1" Columns="3">
                            <!-- CARD 1: HSR -->
                            <Border Style="{StaticResource HeroBannerGameCard}" BorderBrush="#3b82f6" BorderThickness="2" MouseLeftButtonDown="GameCard_Click" Tag="hsr" ToolTip="Nhấp để VÀO DỊCH THUẬT">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.4*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <!-- HERO BANNER IMAGE CONTAINER (60% RATIO) -->
                                    <Grid Grid.Row="0">
                                        <Image x:Name="ImgCardHsr" Stretch="UniformToFill"/>
                                        <Border Background="#20000000"/>
                                        <!-- BOTTOM FADE GRADIENT OVERLAY -->
                                        <Border VerticalAlignment="Bottom" Height="35">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00181b26" Offset="0"/>
                                                    <GradientStop Color="#FF181b26" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- TOP-LEFT VERSION BADGE -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#c01e3a29" BorderBrush="#4ade80" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="v4.4" Foreground="#4ade80" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- TOP-RIGHT FLOATING GLASS ACTION BUTTONS -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="🚀" ToolTip="Vào dịch thuật" Click="GameCard_Click" Tag="hsr"/>
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="🔄" ToolTip="Cập nhật CSDL" Click="BtnOpenAddProject_Click" Tag="hsr"/>
                                            <Button Style="{StaticResource FloatingGlassDangerBtn}" Content="🗑️" ToolTip="Xóa CSDL" Click="BtnDeleteAsset_Click" Tag="hsr"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CARD BOTTOM INFO CONTAINER (TEXT PULLED UP DIRECTLY UNDER IMAGE) -->
                                    <Border Grid.Row="1" Padding="12,8" VerticalAlignment="Top">
                                        <StackPanel VerticalAlignment="Top">
                                            <TextBlock Text="Honkai: Star Rail" Foreground="#f1f5f9" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="169.6 MB • Sẵn sàng" Foreground="#38bdf8" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- CARD 2: GENSHIN -->
                            <Border Style="{StaticResource HeroBannerGameCard}" MouseLeftButtonDown="GameCard_Click" Tag="genshin" ToolTip="Nhấp để tải hoặc quản lý CSDL">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.4*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <!-- HERO BANNER IMAGE CONTAINER (60% RATIO) -->
                                    <Grid Grid.Row="0">
                                        <Image x:Name="ImgCardGenshin" Stretch="UniformToFill"/>
                                        <Border Background="#20000000"/>
                                        <!-- BOTTOM FADE GRADIENT OVERLAY -->
                                        <Border VerticalAlignment="Bottom" Height="35">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00181b26" Offset="0"/>
                                                    <GradientStop Color="#FF181b26" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- TOP-LEFT VERSION BADGE -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#c03a2e1a" BorderBrush="#d97706" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="v---" Foreground="#eab308" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- TOP-RIGHT FLOATING GLASS ACTION BUTTONS -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="📥" ToolTip="Tải CSDL Genshin" Click="BtnOpenAddProject_Click" Tag="genshin"/>
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="🔄" ToolTip="Cập nhật CSDL" Click="BtnOpenAddProject_Click" Tag="genshin"/>
                                            <Button Style="{StaticResource FloatingGlassDangerBtn}" Content="🗑️" ToolTip="Xóa tệp CSDL" Click="BtnDeleteAsset_Click" Tag="genshin"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CARD BOTTOM INFO CONTAINER (TEXT PULLED UP DIRECTLY UNDER IMAGE) -->
                                    <Border Grid.Row="1" Padding="12,8" VerticalAlignment="Top">
                                        <StackPanel VerticalAlignment="Top">
                                            <TextBlock Text="Genshin Impact" Foreground="#f1f5f9" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Chưa tải CSDL" Foreground="#eab308" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- CARD 3: ZZZ -->
                            <Border Style="{StaticResource HeroBannerGameCard}" MouseLeftButtonDown="GameCard_Click" Tag="zzz" ToolTip="Nhấp để tải hoặc quản lý CSDL">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.4*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <!-- HERO BANNER IMAGE CONTAINER (60% RATIO) -->
                                    <Grid Grid.Row="0">
                                        <Image x:Name="ImgCardZzz" Stretch="UniformToFill"/>
                                        <Border Background="#20000000"/>
                                        <!-- BOTTOM FADE GRADIENT OVERLAY -->
                                        <Border VerticalAlignment="Bottom" Height="35">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00181b26" Offset="0"/>
                                                    <GradientStop Color="#FF181b26" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- TOP-LEFT VERSION BADGE -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#c03a2e1a" BorderBrush="#d97706" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="v---" Foreground="#eab308" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- TOP-RIGHT FLOATING GLASS ACTION BUTTONS -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="📥" ToolTip="Tải CSDL ZZZ" Click="BtnOpenAddProject_Click" Tag="zzz"/>
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="🔄" ToolTip="Cập nhật CSDL" Click="BtnOpenAddProject_Click" Tag="zzz"/>
                                            <Button Style="{StaticResource FloatingGlassDangerBtn}" Content="🗑️" ToolTip="Xóa tệp CSDL" Click="BtnDeleteAsset_Click" Tag="zzz"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CARD BOTTOM INFO CONTAINER (TEXT PULLED UP DIRECTLY UNDER IMAGE) -->
                                    <Border Grid.Row="1" Padding="12,8" VerticalAlignment="Top">
                                        <StackPanel VerticalAlignment="Top">
                                            <TextBlock Text="Zenless Zone Zero" Foreground="#f1f5f9" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Chưa tải CSDL" Foreground="#eab308" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- QUADRANT 2 (TOP-RIGHT): CSDL & MEMORY METERS (40% ROW HEIGHT SPLIT) -->
                <Border Grid.Column="2" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER WITH VIBRANT VECTOR DATABASE ICON -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Path Data="M12 3c-4.97 0-9 1.79-9 4v10c0 2.21 4.03 4 9 4s9-1.79 9-4V7c0-2.21-4.03-4-9-4zm0 2c3.87 0 7 1.34 7 2s-3.13 2-7 2-7-1.34-7-2 3.13-2 7-2zm0 14c-3.87 0-7-1.34-7-2v-2.23c1.61.78 4.16 1.23 7 1.23s5.39-.45 7-1.23V17c0 .66-3.13 2-7 2z" Fill="#10b981" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Trạng Thái Cơ Sở Dữ Liệu" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- CIRCULAR RING METER DISPLAY -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- RING ICON BADGE -->
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="4">
                                    <TextBlock Text="85%" Foreground="#38bdf8" FontSize="13" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="CSDL Khả Dụng" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="169.6 MB / 500 MB" Foreground="#F1F5F9" FontSize="14" FontWeight="Bold" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <!-- PROGRESS BAR 1: HSR DATA -->
                                <Grid Margin="0,2,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🚂 Star Rail Data" Foreground="#cbd5e1" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="169.6 MB" Foreground="#94a3b8" FontSize="10"/>
                                </Grid>
                                <ProgressBar Value="85" Height="5" Background="#181b26" Foreground="#c084fc" BorderThickness="0" Margin="0,0,0,6"/>

                                <!-- PROGRESS BAR 2: GENSHIN DATA -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚔️ Genshin Data" Foreground="#cbd5e1" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="0 MB" Foreground="#64748b" FontSize="10"/>
                                </Grid>
                                <ProgressBar Value="0" Height="5" Background="#181b26" Foreground="#eab308" BorderThickness="0" Margin="0,0,0,6"/>

                                <!-- PROGRESS BAR 3: ZZZ DATA -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚡ ZZZ Data" Foreground="#cbd5e1" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="0 MB" Foreground="#64748b" FontSize="10"/>
                                </Grid>
                                <ProgressBar Value="0" Height="5" Background="#181b26" Foreground="#38bdf8" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= BOTTOM ROW (ROW 2: 60% VIEWPORT HEIGHT) ================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="38*"/>
                </Grid.ColumnDefinitions>

                <!-- QUADRANT 3 (BOTTOM-LEFT): RECENT TRANSLATION FILES TABLE (60% ROW HEIGHT SPLIT) -->
                <Border Grid.Column="0" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="#f59e0b" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hoạt Động Gần Đây" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <TextBlock Text="Xem tất cả" Foreground="#38bdf8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- RECENT FILES LISTVIEW (60% ROW HEIGHT SPLIT) -->
                        <ListView x:Name="LvRecentFiles" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#d1d5db" FontSize="12" Padding="0" MouseDoubleClick="LvRecentFiles_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="rowBorder" Background="#181b26" BorderBrush="#252a3b" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="rowBorder" Property="Background" Value="#202535"/>
                                                        <Setter TargetName="rowBorder" Property="BorderBrush" Value="#3b82f6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LOẠI PILL BADGE -->
                                        <Border Grid.Column="0" Background="#14532d" CornerRadius="3" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type}" Foreground="#4ade80" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- TÊN TỆP -->
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#f1f5f9" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <!-- DỰ ÁN -->
                                        <TextBlock Grid.Column="2" Text="{Binding Project}" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                        <!-- SỬA ĐỔI -->
                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedTime}" Foreground="#64748b" FontSize="11" VerticalAlignment="Center"/>

                                        <!-- HÀNH ĐỘNG -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconBtn}" Content="✏️" ToolTip="Chỉnh sửa" Click="BtnEditRecent_Click" Tag="{Binding Path}"/>
                                            <Button Style="{StaticResource IconBtn}" Content="🗑️" ToolTip="Xóa" Click="BtnDeleteAsset_Click" Tag="{Binding Path}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- QUADRANT 4 (BOTTOM-RIGHT): TRANSLATION ACTIVITY CHART (60% ROW HEIGHT SPLIT) -->
                <Border Grid.Column="2" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER WITH VIBRANT VECTOR CHART ICON -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" Fill="#8b5cf6" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Biểu Đồ Thống Kê Dịch" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <!-- HISTOGRAM BAR CHART SIMULATION (60% ROW HEIGHT SPLIT) -->
                        <Grid Grid.Row="1" Margin="10,10,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- BAR 1 (MON) -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Width="22" Height="75" Background="#f97316" CornerRadius="4"/>
                                <TextBlock Text="T2" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- BAR 2 (TUE) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Width="22" Height="130" Background="#38bdf8" CornerRadius="4"/>
                                <TextBlock Text="T3" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- BAR 3 (WED) -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Width="22" Height="175" Background="#ef4444" CornerRadius="4"/>
                                <TextBlock Text="T4" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- BAR 4 (THU) -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Width="22" Height="110" Background="#c084fc" CornerRadius="4"/>
                                <TextBlock Text="T5" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- BAR 5 (FRI) -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Width="22" Height="150" Background="#3b82f6" CornerRadius="4"/>
                                <TextBlock Text="T6" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- LEGEND -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <Border Width="7" Height="7" CornerRadius="4" Background="#38bdf8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="TextMap" Foreground="#94a3b8" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <Border Width="7" Height="7" CornerRadius="4" Background="#ef4444" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Wiki Entry" Foreground="#94a3b8" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="4" Background="#c084fc" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="CSDL DB" Foreground="#94a3b8" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- DOWNLOAD PROJECT MODAL (COMPACT SLEEK LAYOUT WITH PURE DARK COMBOBOX) -->
        <Border x:Name="AddProjectModalOverlay" Visibility="Collapsed" Background="#c0000000">
            <Border Style="{StaticResource DashCard}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0" Background="#1a1d23" Padding="20,14" BorderBrush="#1e293b" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="☁️ " FontSize="14"/>
                                <TextBlock x:Name="TxtModalGameTitle" Text="TẢI DỰ ÁN ZENLESS ZONE ZERO" Foreground="White" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <Button Content="✕" Foreground="#9ca3af" Background="Transparent" BorderThickness="0" FontSize="16" HorizontalAlignment="Right" Cursor="Hand" Click="CloseAddProjectModal_Click"/>
                        </Grid>
                    </Border>

                    <!-- BODY -->
                    <Border Grid.Row="1" Padding="20,16,20,12">
                        <StackPanel>
                            <TextBlock Text="CHỌN NGUỒN TẢI (DOWNLOAD SOURCE):" Foreground="#94a3b8" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                            
                            <!-- PURE DARK COMBOBOX -->
                            <ComboBox x:Name="CboDownloadSource" Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="0" Margin="0,0,0,8">
                                <ComboBoxItem Content="GitLab (AnimeGameData - Mặc định)"/>
                                <ComboBoxItem Content="Saccharose Wiki (Dynamic API - Khuyên dùng)"/>
                                <ComboBoxItem Content="Chạy thử (Mock Download - Không cần mạng)"/>
                            </ComboBox>

                            <!-- DYNAMIC PROGRESS AREA (HIDDEN UNTIL CLICKING TẢI VỀ) -->
                            <StackPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="0,8,0,4">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtProgressStatus" Text="KHỞI ĐỘNG TẢI..." Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtProgressPercent" Text="0%" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PbOverall" Value="0" Height="4" Background="#0f172a" Foreground="#3b82f6" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- FOOTER WITH ANIMATED HOVER BUTTONS -->
                    <Border Grid.Row="2" Background="#14161f" Padding="20,12" BorderBrush="#1e293b" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- LEFT: DỪNG LẠI (HEIGHT 42 & HOVER EFFECT) -->
                            <Button Grid.Column="0" x:Name="BtnStopDownload" Style="{StaticResource ModalFooterBtn}" Content="DỪNG LẠI" Margin="0,0,8,0" Click="CloseAddProjectModal_Click"/>

                            <!-- RIGHT: TẢI VỀ / ĐANG TẢI... (HEIGHT 42 & HOVER EFFECT) -->
                            <Button Grid.Column="1" x:Name="BtnConfirmDownload" Style="{StaticResource ModalPrimaryBtn}" Content="TẢI VỀ" Margin="8,0,0,0" Click="StartDownloadFromModal_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
