<UserControl x:Class="EtherEditorNative.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0b0c10">
    <UserControl.Resources>
        <!-- SOLID DARK DASHBOARD CARD STYLE (STRICT MATCH WITH USER UI SCREENSHOT) -->
        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="#12141c"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#1e2230"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- STEAM/HOYOLAB STYLE HERO BANNER GAME CARD (75% BANNER IMAGE RATIO) -->
        <Style x:Key="HeroBannerGameCard" TargetType="Border">
            <Setter Property="Background" Value="#181b26"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#252a3b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202535"/>
                    <Setter Property="BorderBrush" Value="#3b82f6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- FLOATING GLASS ACTION BUTTONS FOR HERO BANNER CARDS (28x28) -->
        <Style x:Key="FloatingGlassBtn" TargetType="Button">
            <Setter Property="Background" Value="#a0141824"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#40ffffff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3b82f6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60a5fa"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FloatingGlassDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#a0291215"/>
            <Setter Property="Foreground" Value="#f87171"/>
            <Setter Property="BorderBrush" Value="#60ef4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ef4444"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#fca5a5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACTION ICON BUTTON (30x30) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="#1e2230"/>
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2d3345"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3b82f6"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60a5fa"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PURE DARK COMBOBOX TOGGLE BUTTON TEMPLATE -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#3b82f6"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#3b82f6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- PURE DARK COMBOBOX TEMPLATE -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#181a20"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#2d3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid">
                            <ToggleButton x:Name="toggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            
                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}" 
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" 
                                        Background="#14161f" 
                                        BorderBrush="#2d3142" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Margin="0,4,0,0" 
                                        MinWidth="{Binding ActualWidth, ElementName=mainGrid}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Background="#14161f" Foreground="#f1f5f9">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3b82f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DARK COMBOBOX ITEM STYLE -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#14161f"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2563eb"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODAL FOOTER BUTTON WITH ANIMATED HOVER -->
        <Style x:Key="ModalFooterBtn" TargetType="Button">
            <Setter Property="Background" Value="#14161f"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="BorderBrush" Value="#2d3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222734"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODAL PRIMARY BUTTON WITH ANIMATED HOVER -->
        <Style x:Key="ModalPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#60a5fa"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#93c5fd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainRootGrid">
        <!-- BACKGROUND WALLPAPER WITH OVERLAY -->
        <Grid>
            <Image x:Name="ImgBgWallpaper" Stretch="UniformToFill" Opacity="0.18"/>
            <Border Background="#0b0c10" Opacity="0.92"/>
        </Grid>

        <!-- MAIN DASHBOARD (PERFECT 4/6 HEIGHT RATIO SPLIT) -->
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="6*"/>
            </Grid.RowDefinitions>

            <!-- ================= TOP ROW (ROW 0: 40% VIEWPORT HEIGHT) ================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="38*"/>
                </Grid.ColumnDefinitions>

                <!-- QUADRANT 1 (TOP-LEFT): PROJECT WORKSPACES (40% ROW HEIGHT SPLIT) -->
                <Border Grid.Column="0" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER WITH VIBRANT VECTOR FOLDER ICON -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#3b82f6" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dự Án Game Dịch Thuật" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#1c202d" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="3 Dự án khả dụng" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- 3 STEAM/HOYOLAB HERO BANNER CARDS GRID (EXACT 75% BANNER IMAGE COVERAGE RATIO) -->
                        <UniformGrid Grid.Row="1" Columns="3">
                            <!-- CARD 1: HSR -->
                            <Border Style="{StaticResource HeroBannerGameCard}" BorderBrush="#3b82f6" BorderThickness="2" MouseLeftButtonDown="GameCard_Click" Tag="hsr" ToolTip="Nhấp để VÀO DỊCH THUẬT">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <!-- HERO BANNER IMAGE CONTAINER (EXACT 75% BANNER RATIO) -->
                                    <Grid Grid.Row="0">
                                        <Image x:Name="ImgCardHsr" Stretch="UniformToFill"/>
                                        <Border Background="#10000000"/>
                                        <!-- BOTTOM FADE GRADIENT OVERLAY -->
                                        <Border VerticalAlignment="Bottom" Height="35">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00181b26" Offset="0"/>
                                                    <GradientStop Color="#FF181b26" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- TOP-LEFT VERSION BADGE -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#c01e3a29" BorderBrush="#4ade80" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="v4.4" Foreground="#4ade80" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- TOP-RIGHT FLOATING GLASS ACTION BUTTONS -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="🚀" ToolTip="Vào dịch thuật" Click="GameCard_Click" Tag="hsr"/>
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="🔄" ToolTip="Cập nhật CSDL" Click="BtnOpenAddProject_Click" Tag="hsr"/>
                                            <Button Style="{StaticResource FloatingGlassDangerBtn}" Content="🗑️" ToolTip="Xóa CSDL" Click="BtnDeleteAsset_Click" Tag="hsr"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CARD BOTTOM INFO CONTAINER (EXACT 25% LOWER AREA - PADDED ELEGANTLY) -->
                                    <Border Grid.Row="1" Padding="12,4,12,8" VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Honkai: Star Rail" Foreground="#f1f5f9" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="169.6 MB • Sẵn sàng" Foreground="#38bdf8" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- CARD 2: GENSHIN -->
                            <Border Style="{StaticResource HeroBannerGameCard}" MouseLeftButtonDown="GameCard_Click" Tag="genshin" ToolTip="Nhấp để tải hoặc quản lý CSDL">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <!-- HERO BANNER IMAGE CONTAINER (EXACT 75% BANNER RATIO) -->
                                    <Grid Grid.Row="0">
                                        <Image x:Name="ImgCardGenshin" Stretch="UniformToFill"/>
                                        <Border Background="#10000000"/>
                                        <!-- BOTTOM FADE GRADIENT OVERLAY -->
                                        <Border VerticalAlignment="Bottom" Height="35">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00181b26" Offset="0"/>
                                                    <GradientStop Color="#FF181b26" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- TOP-LEFT VERSION BADGE -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#c03a2e1a" BorderBrush="#d97706" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="v---" Foreground="#eab308" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- TOP-RIGHT FLOATING GLASS ACTION BUTTONS -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="📥" ToolTip="Tải CSDL Genshin" Click="BtnOpenAddProject_Click" Tag="genshin"/>
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="🔄" ToolTip="Cập nhật CSDL" Click="BtnOpenAddProject_Click" Tag="genshin"/>
                                            <Button Style="{StaticResource FloatingGlassDangerBtn}" Content="🗑️" ToolTip="Xóa tệp CSDL" Click="BtnDeleteAsset_Click" Tag="genshin"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CARD BOTTOM INFO CONTAINER (EXACT 25% LOWER AREA - PADDED ELEGANTLY) -->
                                    <Border Grid.Row="1" Padding="12,4,12,8" VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Genshin Impact" Foreground="#f1f5f9" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Chưa tải CSDL" Foreground="#eab308" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- CARD 3: ZZZ -->
                            <Border Style="{StaticResource HeroBannerGameCard}" MouseLeftButtonDown="GameCard_Click" Tag="zzz" ToolTip="Nhấp để tải hoặc quản lý CSDL">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <!-- HERO BANNER IMAGE CONTAINER (EXACT 75% BANNER RATIO) -->
                                    <Grid Grid.Row="0">
                                        <Image x:Name="ImgCardZzz" Stretch="UniformToFill"/>
                                        <Border Background="#10000000"/>
                                        <!-- BOTTOM FADE GRADIENT OVERLAY -->
                                        <Border VerticalAlignment="Bottom" Height="35">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00181b26" Offset="0"/>
                                                    <GradientStop Color="#FF181b26" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- TOP-LEFT VERSION BADGE -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#c03a2e1a" BorderBrush="#d97706" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="v---" Foreground="#eab308" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- TOP-RIGHT FLOATING GLASS ACTION BUTTONS -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="📥" ToolTip="Tải CSDL ZZZ" Click="BtnOpenAddProject_Click" Tag="zzz"/>
                                            <Button Style="{StaticResource FloatingGlassBtn}" Content="🔄" ToolTip="Cập nhật CSDL" Click="BtnOpenAddProject_Click" Tag="zzz"/>
                                            <Button Style="{StaticResource FloatingGlassDangerBtn}" Content="🗑️" ToolTip="Xóa tệp CSDL" Click="BtnDeleteAsset_Click" Tag="zzz"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CARD BOTTOM INFO CONTAINER (EXACT 25% LOWER AREA - PADDED ELEGANTLY) -->
                                    <Border Grid.Row="1" Padding="12,4,12,8" VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Zenless Zone Zero" Foreground="#f1f5f9" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Chưa tải CSDL" Foreground="#eab308" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- QUADRANT 2 (TOP-RIGHT): SPLIT INTO 2 DISTINCT CARDS WITH ELEGANT GAP -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CARD 2A (TOP BOX): DUNG LƯỢNG & SẴN SÀNG (ALIGNED PIXEL-PERFECTLY WITH CARD 1) -->
                    <Border Grid.Row="0" Style="{StaticResource DashCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER WITH VIBRANT VECTOR STORAGE ICON (MATCHES CARD 1 HEADERS) -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <Path Data="M12 3c-4.97 0-9 1.79-9 4v10c0 2.21 4.03 4 9 4s9-1.79 9-4V7c0-2.21-4.03-4-9-4zm0 2c3.87 0 7 1.34 7 2s-3.13 2-7 2-7-1.34-7-2 3.13-2 7-2zm0 14c-3.87 0-7-1.34-7-2v-2.23c1.61.78 4.16 1.23 7 1.23s5.39-.45 7-1.23V17c0 .66-3.13 2-7 2z" Fill="#10b981" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dung Lượng Cơ Sở Dữ Liệu" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>

                            <!-- CONTENT: RING BADGE + TEXT (CENTERED & PUSHED DOWN 3PX) -->
                            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- RING BADGE 1/3 -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDbReadyRatio" Text="1/3" Foreground="#38bdf8" FontSize="13" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="Dự Án Đã Sẵn Sàng" Foreground="#94a3b8" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtDbTotalSize" Text="169.6 MB Local Storage" Foreground="#F1F5F9" FontSize="13" FontWeight="Bold" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CARD 2B (BOTTOM BOX): PHÂN BỔ DỮ LIỆU DONUT CHART -->
                    <Border Grid.Row="2" Style="{StaticResource DashCard}" Padding="14,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER WITH VIBRANT VECTOR DATABASE ICON -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                <Path Data="M12 3c-4.97 0-9 1.79-9 4v10c0 2.21 4.03 4 9 4s9-1.79 9-4V7c0-2.21-4.03-4-9-4zm0 2c3.87 0 7 1.34 7 2s-3.13 2-7 2-7-1.34-7-2 3.13-2 7-2zm0 14c-3.87 0-7-1.34-7-2v-2.23c1.61.78 4.16 1.23 7 1.23s5.39-.45 7-1.23V17c0 .66-3.13 2-7 2z" Fill="#10b981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Phân Bổ Cơ Sở Dữ Liệu" Style="{StaticResource SectionTitle}" FontSize="13"/>
                            </StackPanel>

                            <!-- DONUT CHART (CLEAN MINIMALIST INTERACTIVE HOVER) + BOTTOM LEGEND -->
                            <Grid x:Name="Card2BGrid" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- AUTOSCALING DOUBLE-SIZED SOLID PIE CHART (260PX DIAMETER IN 280X280 VIEWPORT) -->
                                <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,2">
                                    <Grid x:Name="PieCanvas" Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center" MouseMove="PieCanvas_MouseMove" MouseLeave="PieCanvas_MouseLeave">
                                        <Grid.Resources>
                                            <!-- BASE SOLID PIE SLICE STYLE WITH ANIMATED DIMMING -->
                                            <Style x:Key="PieSlicePathStyle" TargetType="Path">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <!-- STYLE SLICE 1: PURPLE (SMOOTH STORYBOARD FOCUS & DIMMING) -->
                                            <Style x:Key="PurpleSliceStyle" TargetType="Path" BasedOn="{StaticResource PieSlicePathStyle}">
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Panel.ZIndex" Value="99"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#c084fc" BlurRadius="28" ShadowDepth="0" Opacity="0.95"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>

                                            <!-- STYLE SLICE 2: GREEN (SMOOTH STORYBOARD FOCUS & DIMMING) -->
                                            <Style x:Key="GreenSliceStyle" TargetType="Path" BasedOn="{StaticResource PieSlicePathStyle}">
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Panel.ZIndex" Value="99"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#10b981" BlurRadius="28" ShadowDepth="0" Opacity="0.95"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>

                                            <!-- STYLE SLICE 3: YELLOW (SMOOTH STORYBOARD FOCUS & DIMMING) -->
                                            <Style x:Key="YellowSliceStyle" TargetType="Path" BasedOn="{StaticResource PieSlicePathStyle}">
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Panel.ZIndex" Value="99"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#eab308" BlurRadius="28" ShadowDepth="0" Opacity="0.95"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Resources>

                                        <!-- BASE TRACK BACKGROUND CIRCLE (260X260 CENTERED AT 140,140) -->
                                        <Ellipse Width="260" Height="260" Fill="#181b26" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- SLICE 1: SOLID TEXTMAP 70% (PURPLE - 260PX DIAMETER) -->
                                        <Path x:Name="Slice1" Style="{StaticResource PurpleSliceStyle}" Fill="#c084fc" Data="M 140,140 L 140,10 A 130,130 0 1 1 16.36,180.17 Z" Width="280" Height="280" HorizontalAlignment="Left" VerticalAlignment="Top" Tag="TextMap|70%|#c084fc" MouseEnter="PieSlice_MouseEnter"/>

                                        <!-- SLICE 2: SOLID INDEX DB 22% (GREEN - 260PX DIAMETER) -->
                                        <Path x:Name="Slice2" Style="{StaticResource GreenSliceStyle}" Fill="#10b981" Data="M 140,140 L 16.36,180.17 A 130,130 0 0 1 77.37,26.08 Z" Width="280" Height="280" HorizontalAlignment="Left" VerticalAlignment="Top" Tag="Index DB|22%|#10b981" MouseEnter="PieSlice_MouseEnter"/>

                                        <!-- SLICE 3: SOLID WIKI CACHE 8% (YELLOW - 260PX DIAMETER) -->
                                        <Path x:Name="Slice3" Style="{StaticResource YellowSliceStyle}" Fill="#eab308" Data="M 140,140 L 77.37,26.08 A 130,130 0 0 1 140,10 Z" Width="280" Height="280" HorizontalAlignment="Left" VerticalAlignment="Top" Tag="Wiki Cache|8%|#eab308" MouseEnter="PieSlice_MouseEnter"/>

                                        <Grid.Triggers>
                                            <!-- WHEN MOUSE ENTERS CHART CANVAS, IMMEDIATELY DIM ALL SLICES ON FIRST TOUCH -->
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Slice1" Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice2" Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice3" Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>

                                            <!-- WHEN MOUSE LEAVES CHART CANVAS, RESTORE ALL SLICES BACK TO 100% OPACITY & 1.0 SCALE -->
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Slice1" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice2" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice3" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice1" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice1" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice2" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice2" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice3" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="Slice3" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                </Viewbox>

                                        <!-- HIGH-PERFORMANCE UNCLIPPED REALTIME MOUSE-FOLLOWING TOOLTIP OVERLAY CARD -->
                                <Border x:Name="PieToolTipCard" Visibility="Collapsed" IsHitTestVisible="False" Background="#121318" BorderBrush="#3b82f6" BorderThickness="1.5" CornerRadius="5" Padding="9,5" Panel.ZIndex="9999" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.8"/>
                                    </Border.Effect>
                                    <TextBlock x:Name="ToolTipPercent" Text="70%" Foreground="#ffffff" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>

                                <!-- LEGEND DETAILS (RESTORED WITH MB SIZES AS USUAL) -->
                                <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,6,0,6">
                                    <!-- ITEM 1 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <Border Width="7.5" Height="7.5" CornerRadius="3.75" Background="#c084fc" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="TextMap " Foreground="#cbd5e1" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="118.5 MB" Foreground="#94a3b8" FontSize="11.5"/>
                                    </StackPanel>

                                    <!-- ITEM 2 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <Border Width="7.5" Height="7.5" CornerRadius="3.75" Background="#10b981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Index DB " Foreground="#cbd5e1" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="38.2 MB" Foreground="#94a3b8" FontSize="11.5"/>
                                    </StackPanel>

                                    <!-- ITEM 3 -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7.5" Height="7.5" CornerRadius="3.75" Background="#eab308" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Wiki Cache " Foreground="#cbd5e1" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="12.9 MB" Foreground="#94a3b8" FontSize="11.5"/>
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= BOTTOM ROW (ROW 2: 60% VIEWPORT HEIGHT) ================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="38*"/>
                </Grid.ColumnDefinitions>

                <!-- QUADRANT 3 (BOTTOM-LEFT): RECENT TRANSLATION FILES TABLE (60% ROW HEIGHT SPLIT) -->
                <Border Grid.Column="0" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="#f59e0b" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hoạt Động Gần Đây" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <TextBlock Text="Xem tất cả" Foreground="#38bdf8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- RECENT FILES LISTVIEW (60% ROW HEIGHT SPLIT) -->
                        <ListView x:Name="LvRecentFiles" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#d1d5db" FontSize="12" Padding="0" MouseDoubleClick="LvRecentFiles_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="rowBorder" Background="#181b26" BorderBrush="#252a3b" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="rowBorder" Property="Background" Value="#202535"/>
                                                        <Setter TargetName="rowBorder" Property="BorderBrush" Value="#3b82f6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LOẠI PILL BADGE -->
                                        <Border Grid.Column="0" Background="#14532d" CornerRadius="3" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type}" Foreground="#4ade80" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- TÊN TỆP -->
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#f1f5f9" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <!-- DỰ ÁN -->
                                        <TextBlock Grid.Column="2" Text="{Binding Project}" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                        <!-- SỬA ĐỔI -->
                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedTime}" Foreground="#64748b" FontSize="11" VerticalAlignment="Center"/>

                                        <!-- HÀNH ĐỘNG -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconBtn}" Content="✏️" ToolTip="Chỉnh sửa" Click="BtnEditRecent_Click" Tag="{Binding Path}"/>
                                            <Button Style="{StaticResource IconBtn}" Content="🗑️" ToolTip="Xóa" Click="BtnDeleteAsset_Click" Tag="{Binding Path}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- QUADRANT 4 (BOTTOM-RIGHT): HORIZONTAL CLUSTERED BAR CHART WITH IN-PLACE TAB SWITCHER -->
                <Border Grid.Column="2" Style="{StaticResource DashCard}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER WITH IN-PLACE TAB SWITCHER -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Fill="#8b5cf6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thống Kê Fandom Wiki" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>

                            <!-- TAB SWITCHER BUTTONS (SEAMLESS EQUAL-WIDTH SEGMENTED PILL SWITCHER) -->
                            <Border HorizontalAlignment="Right" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="6" Padding="2">
                                <UniformGrid Columns="2" Width="168">
                                    <Button x:Name="BtnFandomTabArticles" Click="BtnFandomTabArticles_Click" Content="Bài viết" Cursor="Arrow" Height="25" FontSize="11" FontWeight="Bold" Foreground="#0f172a" Background="#38bdf8" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="BtnFandomTabUsers" Click="BtnFandomTabUsers_Click" Content="Người dùng" Cursor="Hand" Height="25" FontSize="11" FontWeight="SemiBold" Foreground="#94a3b8" Background="Transparent" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </UniformGrid>
                            </Border>
                        </Grid>

                        <!-- CHART AREA: HORIZONTAL CLUSTERED BAR CHART (FILLS FULL CARD HEIGHT) -->
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <!-- BACKGROUND VERTICAL GRIDLINES AT EACH X-AXIS TICK (STRETCHES FULL CHART HEIGHT) -->
                            <Grid Margin="38,4,10,24" Panel.ZIndex="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="1" Background="#1e293b" HorizontalAlignment="Left" Opacity="0.7"/>
                                <Border Grid.Column="0" Width="1" Background="#1e293b" HorizontalAlignment="Right" Opacity="0.7"/>
                                <Border Grid.Column="1" Width="1" Background="#1e293b" HorizontalAlignment="Right" Opacity="0.7"/>
                                <Border Grid.Column="2" Width="1" Background="#1e293b" HorizontalAlignment="Right" Opacity="0.7"/>
                                <Border Grid.Column="3" Width="1" Background="#1e293b" HorizontalAlignment="Right" Opacity="0.7"/>
                                <Border Grid.Column="4" Width="1" Background="#1e293b" HorizontalAlignment="Right" Opacity="0.7"/>
                            </Grid>

                            <!-- ==================== TAB 1: BÀI VIẾT CHART ==================== -->
                            <Grid x:Name="PanelFandomArticles" Visibility="Visible" Panel.ZIndex="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- CLUSTERED ROW 1: GENSHIN IMPACT -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ROBOTO SLATE GRAY STYLED Y-AXIS LABEL FOR GI (STATIC) -->
                                    <TextBlock Grid.Column="0" Text="GI" FontFamily="Roboto, Segoe UI" Foreground="#94a3b8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>

                                    <!-- CLUSTERED BARS AREA (ANIMATED BARS ONLY) -->
                                    <StackPanel x:Name="BarsRowGiArticles" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                        <!-- BAR EN (40.6K / 50K = 81.2%) -->
                                        <Grid Height="22" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="ColGiEngArticlesBar" Width="40.6*"/>
                                                <ColumnDefinition x:Name="ColGiEngArticlesRest" Width="9.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#818cf8" CornerRadius="3"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtGiEngArticles" Text="40.6K" Foreground="#818cf8" FontSize="11.5" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- BAR VI (17.6K / 50K = 35.2%) -->
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="ColGiViArticlesBar" Width="17.6*"/>
                                                <ColumnDefinition x:Name="ColGiViArticlesRest" Width="32.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#38bdf8" CornerRadius="3"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtGiViArticles" Text="17.6K" Foreground="#38bdf8" FontSize="11.5" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- CLUSTERED ROW 2: HONKAI STAR RAIL -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ROBOTO SLATE GRAY STYLED Y-AXIS LABEL FOR HSR (STATIC) -->
