                                                        </Border>
                                                        <Border Style="{StaticResource VsLightInputStyle}">
                                                            <TextBox x:Name="TxtNmtGasC" Text="" Background="Transparent" Foreground="#ffffff" CaretBrush="#007acc" BorderThickness="0" FontSize="13" Padding="12,10" VerticalAlignment="Center" LostFocus="OnSettingChanged"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <!-- NMT Tier 2 -->
                                                <Border Background="#252526" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Text="TẦNG 2: DEEP-TRANSLATOR" Foreground="#fbbf24" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,12"/>
                                                        <TextBlock Text="THỜI GIAN CHỜ GIỮA CÁC YÊU CẦU (DELAY)" Foreground="#aaaaaa" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="CmbNmtDelay" Style="{StaticResource VsLightComboStyle}" SelectedIndex="1" SelectionChanged="OnSettingChanged">
                                                            <ComboBoxItem Content="0.5 giây"/>
                                                            <ComboBoxItem Content="1.0 giây (Mặc định)" IsSelected="True"/>
                                                            <ComboBoxItem Content="1.5 giây"/>
                                                            <ComboBoxItem Content="2.0 giây"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Border>

                                                <!-- NMT Tier 3 -->
                                                <Border Background="#252526" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="8" Padding="20">
                                                    <StackPanel>
                                                        <TextBlock Text="TẦNG 3: RAPIDAPI WRAPPER" Foreground="#4ade80" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,12"/>
                                                        <Border Style="{StaticResource VsLightInputStyle}">
                                                            <PasswordBox x:Name="TxtNmtRapidKey" Password="" Background="Transparent" Foreground="#ffffff" CaretBrush="#007acc" BorderThickness="0" FontSize="13.5" Padding="12,10" VerticalAlignment="Center" LostFocus="OnSettingChanged"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. MODAL TỪ ĐIỂN ƯU TIÊN (PRIORITY GLOSSARY MODAL) -->
            <Border x:Name="BorderModalGlossary" Visibility="Collapsed" 
                    Width="1180" Height="744" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Background="#1e1e24" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,12,12,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📖 " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Quản lý Từ điển ưu tiên (Priority Glossary)" Foreground="#ffffff" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Click="BtnCloseModal_Click" Style="{StaticResource VsSquareCloseBtn}" ToolTip="Đóng từ điển" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- PANEL THÊM THUẬT NGỮ MỚI & CHỌN DANH MỤC -->
                    <Border Grid.Row="1" Background="#202225" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Thuật ngữ gốc -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Thuật ngữ gốc (Source Text):" Foreground="#4fc1ff" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource VsLightInputStyle}" Height="34">
                                    <TextBox x:Name="TxtNewTermEn" Background="Transparent" Foreground="#ffffff" CaretBrush="#007acc" BorderThickness="0" FontSize="12.5" Padding="8,6" VerticalAlignment="Center" ToolTip="Ví dụ: March 7th"/>
                                </Border>
                            </StackPanel>

                            <!-- 2. Bản dịch ưu tiên -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Bản dịch ưu tiên (Target Text):" Foreground="#ce9178" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource VsLightInputStyle}" Height="34">
                                    <TextBox x:Name="TxtNewTermVi" Background="Transparent" Foreground="#ffffff" CaretBrush="#007acc" BorderThickness="0" FontSize="12.5" Padding="8,6" VerticalAlignment="Center" ToolTip="Ví dụ: March 7th"/>
                                </Border>
                            </StackPanel>

                            <!-- 3. Danh mục -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Lưu vào danh mục:" Foreground="#cccccc" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbGlossaryCategory" Style="{StaticResource VsLightComboStyle}" SelectedIndex="0" Height="34">
                                    <ComboBoxItem Content="Chung (Toàn cục)" IsSelected="True"/>
                                    <ComboBoxItem Content="Genshin Impact (GI)"/>
                                    <ComboBoxItem Content="Honkai: Star Rail (HSR)"/>
                                    <ComboBoxItem Content="Zenless Zone Zero (ZZZ)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 4. Nút Thêm -->
                            <Button Grid.Column="3" Click="BtnAddGlossaryTerm_Click" Content="+ Thêm từ mới" Style="{StaticResource VsLightPrimaryBtn}" Height="34" Padding="16,0" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <!-- GLOSSARY LIST TABLE -->
                    <Border Grid.Row="2" Padding="0" Background="#1e1e24">
                        <DataGrid x:Name="DgGlossaryList" AutoGenerateColumns="False" 
                                  Background="#1e1e24" RowBackground="#252526" AlternatingRowBackground="#1e1e24"
                                  BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#2d2d2d" Foreground="#d4d4d4" FontSize="12.5" RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="THUẬT NGỮ GỐC (SOURCE)" Binding="{Binding SourceText}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="BẢN DỊCH ƯU TIÊN (TARGET)" Binding="{Binding TargetText}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="DANH MỤC" Binding="{Binding GameId}" Width="130" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="THAO TÁC" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️ Xóa" Click="BtnDeleteGlossaryTerm_Click" Foreground="#f14c4c" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- FOOTER BAR -->
                    <Border Grid.Row="3" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <TextBlock x:Name="TxtGlossarySummary" Text="Hiển thị từ điển ưu tiên" Foreground="#858585" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="BtnSaveGlossary_Click" Content="💾 Lưu thay đổi từ điển" Style="{StaticResource VsLightPrimaryBtn}" Height="34" Margin="0,0,8,0" Padding="16,0"/>
                                <Button Click="BtnCloseModal_Click" Content="Đóng" Style="{StaticResource VsLightSecondaryBtn}" Height="34" Padding="16,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. MODAL TRA CỨU THUẬT NGỮ & WIKI (LOOKUP MODAL) -->
            <Border x:Name="BorderModalLookup" Visibility="Collapsed" 
                    Width="1180" Height="744" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Background="#1e1e24" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,12,12,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍 " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Tra cứu cơ sở dữ liệu TextMap trực quan" Foreground="#ffffff" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Click="BtnCloseModal_Click" Style="{StaticResource VsSquareCloseBtn}" ToolTip="Đóng bảng tra cứu" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- FILTER & SEARCH BAR -->
                    <Border Grid.Row="1" Background="#202225" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Chọn Game -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Chọn game:" Foreground="#cccccc" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbLookupGame" Style="{StaticResource VsLightComboStyle}" SelectedIndex="0" Height="34" SelectionChanged="OnLookupFilterChanged">
                                    <ComboBoxItem Content="Tất cả Game" IsSelected="True"/>
                                    <ComboBoxItem Content="Genshin Impact (GI)"/>
                                    <ComboBoxItem Content="Honkai: Star Rail (HSR)"/>
                                    <ComboBoxItem Content="Zenless Zone Zero (ZZZ)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 2. Tìm trong cột -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Tìm trong cột:" Foreground="#cccccc" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbLookupColumn" Style="{StaticResource VsLightComboStyle}" SelectedIndex="0" Height="34" SelectionChanged="OnLookupFilterChanged">
                                    <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                    <ComboBoxItem Content="Mã ID"/>
                                    <ComboBoxItem Content="Tiếng Anh"/>
                                    <ComboBoxItem Content="Tiếng Việt"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 3. Chuỗi tra cứu -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Chuỗi cần tra cứu:" Foreground="#cccccc" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource VsLightInputStyle}" Height="34">
                                    <TextBox x:Name="TxtLookupQuery" KeyDown="TxtLookupQuery_KeyDown" Background="Transparent" Foreground="#ffffff" CaretBrush="#007acc" BorderThickness="0" FontSize="12.5" Padding="10,6" VerticalAlignment="Center" ToolTip="Nhập chuỗi văn bản cần tra cứu (ví dụ: March 7th)..."/>
                                </Border>
                            </StackPanel>

                            <!-- 4. Nút Tìm kiếm -->
                            <Button Grid.Column="3" Click="BtnPerformLookup_Click" Content="🔍 Tìm kiếm" Style="{StaticResource VsLightPrimaryBtn}" Height="34" Padding="18,0" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <!-- LOOKUP RESULTS TABLE -->
                    <Border Grid.Row="2" Padding="0" Background="#1e1e24">
                        <DataGrid x:Name="DgLookupResults" AutoGenerateColumns="False" 
                                  Background="#1e1e24" RowBackground="#252526" AlternatingRowBackground="#1e1e24"
                                  BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#2d2d2d" Foreground="#d4d4d4" FontSize="12.5" RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ ID" Binding="{Binding Id}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="TIẾNG ANH (EN)" Binding="{Binding SourceText}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="TIẾNG VIỆT (VI)" Binding="{Binding TargetText}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📋 Chèn [[...]]" Click="BtnInsertLookupResult_Click" Foreground="#4ec9b0" Background="#2d2d2d" BorderThickness="0" Padding="8,4" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- PAGINATION FOOTER BAR -->
                    <Border Grid.Row="3" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <TextBlock x:Name="TxtLookupSummary" Text="Hiển thị 0 kết quả tra cứu" Foreground="#858585" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnLookupPrev" Click="BtnLookupPrev_Click" Content="◀ Trang trước" Style="{StaticResource VsLightSecondaryBtn}" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtLookupPage" Text="Trang 1 / 1" Foreground="#cccccc" FontSize="12" VerticalAlignment="Center" Margin="6,0"/>
                                <Button x:Name="BtnLookupNext" Click="BtnLookupNext_Click" Content="Trang sau ▶" Style="{StaticResource VsLightSecondaryBtn}" Height="30" Padding="6,0" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
