<UserControl x:Class="EtherEditorNative.Views.TranslateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e"
             FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- VS CODE SUB-MENU BUTTON STYLE -->
        <Style x:Key="VsMenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3c3c3c"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE RIBBON VERTICAL BUTTON STYLE -->
        <Style x:Key="VsRibbonBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3c3c3c"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE AI ASSISTANT BLUE BUTTON STYLE -->
        <Style x:Key="VsRibbonAiBtn" TargetType="Button">
            <Setter Property="Background" Value="#007acc"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0062a3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE SIDEBAR BUTTON -->
        <Style x:Key="VsSidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007acc"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INTEGRATED INPUT ACTION BUTTON (FILLS RIGHT SECTION OF INPUT BOX FLUSH - MATCHING USER SPECIFICATION) -->
        <Style x:Key="VsInputIntegratedBtn" TargetType="Button">
            <Setter Property="Background" Value="#484d57"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007acc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE DARK COMBOBOX TOGGLE BUTTON -->
        <ControlTemplate x:Key="VsComboToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#858585" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#007acc"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#ffffff"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- VS CODE DARK COMBOBOX STYLE -->
        <Style x:Key="VsDarkComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid">
                            <ToggleButton x:Name="toggleButton" 
                                          Template="{StaticResource VsComboToggleButton}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            
                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}" 
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Fade">
                                <Border x:Name="dropDownBorder" 
                                        Background="#252526" 
                                        BorderBrush="#3c3c3c" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Margin="0,2,0,0" 
                                        Width="{Binding ActualWidth, ElementName=mainGrid}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Background="#252526" Foreground="#cccccc" MaxHeight="220">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 1. VS CODE TOP SUB-MENU BAR (#252526) -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT VS CODE SUB-MENU ITEMS -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnFileMenu" Style="{StaticResource VsMenuBtn}" Content="Tệp" Click="BtnFileMenu_Click"/>
                    <Button x:Name="BtnSearchMenu" Style="{StaticResource VsMenuBtn}" Content="Tra cứu" Click="BtnSearchMenu_Click"/>
                    <Button x:Name="BtnGlossaryMenu" Style="{StaticResource VsMenuBtn}" Content="Từ điển ưu tiên" Click="BtnGlossaryMenu_Click"/>
                    <Button x:Name="BtnSettingsMenu" Style="{StaticResource VsMenuBtn}" Content="Cài đặt" Click="BtnSettingsMenu_Click"/>
                </StackPanel>

                <!-- RIGHT VS CODE FILE SWITCHER PILL -->
                <Border x:Name="BtnFilePickerPill" Grid.Column="2" Background="#3c3c3c" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="BtnFilePickerPill_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="saves / " Foreground="#858585" FontSize="12"/>
                        <TextBlock x:Name="TxtDisplayFileName" Text="kết_quả.mediawiki" Foreground="#cccccc" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text=" ▾" Foreground="#858585" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. VS CODE MAIN EDITOR LAYOUT (SPLIT INTO SIDEBAR & MAIN AREA) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- VS CODE LEFT SIDEBAR (#252526) -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#2d2d2d" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- SECTION 1: QUY TRÌNH XUẤT BẢN -->
                    <Border Grid.Row="0" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="QUY TRÌNH XUẤT BẢN" Foreground="#bbbbbb" FontSize="11.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                                <Button Style="{StaticResource VsMenuBtn}" Content="«" HorizontalAlignment="Right" Padding="6,2" FontSize="12" ToolTip="Thu gọn sidebar"/>
                            </Grid>

                            <!-- BƯỚC 1: CHỌN GAME -->
                            <TextBlock Text="1. CHỌN GAME:" Foreground="#858585" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbGameSelect" Style="{StaticResource VsDarkComboStyle}" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="CmbGameSelect_SelectionChanged">
                                <ComboBoxItem Content="Honkai: Star Rail" IsSelected="True" Tag="hsr"/>
                                <ComboBoxItem Content="Genshin Impact" Tag="genshin"/>
                                <ComboBoxItem Content="Zenless Zone Zero" Tag="zzz"/>
                            </ComboBox>

                            <!-- BƯỚC 2: TIÊU ĐỀ ANH -->
                            <TextBlock Text="2. TIÊU ĐỀ ANH (SOURCE):" Foreground="#858585" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#2d3036" BorderBrush="#3c3f47" BorderThickness="1" CornerRadius="6" Height="36" Padding="0" ClipToBounds="True" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTitleEn" Background="Transparent" Foreground="#d0d4dc" BorderThickness="0" FontSize="12.5" Padding="10,0,6,0" VerticalContentAlignment="Center" Text="Tên bài Anh..."/>
                                    <Button x:Name="BtnFetchEn" Grid.Column="1" Click="BtnFetchEn_Click" Style="{StaticResource VsInputIntegratedBtn}" ToolTip="Tải từ Wiki EN">
                                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 8 2 L 8 10 M 5 7 L 8 10 L 11 7 M 3 13 L 13 13 L 13 15 L 3 15 Z" Stroke="#ffffff" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- BƯỚC 3: TIÊU ĐỀ VIỆT -->
                            <TextBlock Text="3. TIÊU ĐỀ VIỆT (TARGET):" Foreground="#858585" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#2d3036" BorderBrush="#3c3f47" BorderThickness="1" CornerRadius="6" Height="36" Padding="0" ClipToBounds="True" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTitleVi" Background="Transparent" Foreground="#d0d4dc" BorderThickness="0" FontSize="12.5" Padding="10,0,6,0" VerticalContentAlignment="Center" Text="Tên bài Việt..."/>
                                    <Button x:Name="BtnPublishVi" Grid.Column="1" Click="BtnPublishVi_Click" Style="{StaticResource VsInputIntegratedBtn}" ToolTip="Đăng bài lên Wiki VI / Lưu tệp">
                                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 8 11 L 8 3 M 5 6 L 8 3 L 11 6 M 3 13 L 13 13 L 13 15 L 3 15 Z" Stroke="#ffffff" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: THAY ĐỔI GẦN ĐÂY ON WIKI -->
                    <Border Grid.Row="1" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🕒 " FontSize="11" Foreground="#858585"/>
                                    <TextBlock Text="THAY ĐỔI GẦN ĐÂY" Foreground="#bbbbbb" FontSize="11.5" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSyncTime" Text="FS: 5m 52s" Foreground="#858585" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- RECENT WIKI CHANGES TIMELINE ITEMS -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Lỗi tải hoạt động Wiki" Foreground="#f14c4c" FontSize="12" Margin="0,4,0,12"/>

                                    <Border Background="#1e1e1e" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="March 7th" Foreground="#cccccc" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Cập nhật bản dịch 4.4 • 2 phút trước" Foreground="#858585" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1e1e1e" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Kafka/Dialogue" Foreground="#cccccc" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Sửa thuật ngữ • 15 phút trước" Foreground="#858585" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1e1e1e" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="5" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="Dan Heng/Story" Foreground="#cccccc" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Thêm dòng thoại mới • 1 giờ trước" Foreground="#858585" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: VS CODE RIBBON & CODE EDITOR PANE (#1E1E1E) -->
            <Grid Grid.Column="1" Background="#1e1e1e">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- VS CODE RIBBON TOOLBAR (#252526) WITH EXPLICIT 107PX FRAME HEIGHT -->
                <Border Grid.Row="0" Height="107" Background="#252526" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="16,0">
                    <Grid Height="107">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: TOOLBAR BUTTON GROUPS -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <!-- GROUP 1: BẢNG TẠM -->
                            <Grid Margin="0,0,4,0" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                                    <Button x:Name="BtnUndo" Click="BtnUndo_Click" Style="{StaticResource VsRibbonBtn}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="↺" FontSize="22" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#cccccc"/>
                                            <TextBlock Text="Hoàn tác" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#aaaaaa" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCut" Click="BtnCut_Click" Style="{StaticResource VsRibbonBtn}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="✂" FontSize="21" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#cccccc"/>
                                            <TextBlock Text="Cắt" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#aaaaaa" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCopy" Click="BtnCopy_Click" Style="{StaticResource VsRibbonBtn}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📋" FontSize="21" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#cccccc"/>
                                            <TextBlock Text="Sao chép" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#aaaaaa" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnPaste" Click="BtnPaste_Click" Style="{StaticResource VsRibbonBtn}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📄" FontSize="21" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#cccccc"/>
                                            <TextBlock Text="Dán" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#aaaaaa" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="BẢNG TẠM" Foreground="#707070" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Grid>

                            <!-- DIVIDER LINE | -->
                            <Border Width="1" Background="#3f3f46" Margin="12,10,12,10" VerticalAlignment="Stretch"/>

                            <!-- GROUP 2: CÔNG CỤ WIKI -->
                            <Grid Margin="0,0,4,0" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                                    <Button x:Name="BtnToolLink" Click="BtnToolLink_Click" Style="{StaticResource VsRibbonBtn}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔗" FontSize="21" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#cccccc"/>
                                            <TextBlock Text="Tạo Link" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#aaaaaa" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnToolPipe" Click="BtnToolPipe_Click" Style="{StaticResource VsRibbonBtn}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="[[|]]" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#cccccc"/>
                                            <TextBlock Text="Tạo Pipe" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#aaaaaa" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnToolBold" Click="BtnToolBold_Click" Style="{StaticResource VsRibbonBtn}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="B" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#cccccc"/>
                                            <TextBlock Text="In đậm" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#aaaaaa" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnToolItalic" Click="BtnToolItalic_Click" Style="{StaticResource VsRibbonBtn}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="I" FontSize="21" FontStyle="Italic" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#cccccc"/>
                                            <TextBlock Text="In nghiêng" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#aaaaaa" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="CÔNG CỤ WIKI" Foreground="#707070" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Grid>

                            <!-- DIVIDER LINE | -->
                            <Border Width="1" Background="#3f3f46" Margin="12,10,12,10" VerticalAlignment="Stretch"/>

                            <!-- GROUP 3: THAY THẾ / TRỢ LÝ AI -->
                            <Grid VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Top" Margin="0,6,0,0">
                                    <Button x:Name="BtnAssistant" Click="BtnAssistant_Click" Style="{StaticResource VsRibbonAiBtn}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🎛️" FontSize="21" HorizontalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Text="Trợ lý Dịch" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="THAY THẾ" Foreground="#707070" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Grid>
                        </StackPanel>

                        <!-- RIGHT: PERFORMANCE & SYSTEM HEALTH BADGE -->
                        <Border Grid.Column="2" Background="#1e1e1e" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="16,8" VerticalAlignment="Center" Height="68">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,18,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtRamVal" Text="153.5 MB" Foreground="#007acc" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="RAM" Foreground="#858585" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Width="1" Height="28" Background="#333333" Margin="0,0,18,0"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCpuVal" Text="0 %" Foreground="#e2c08d" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="CPU" Foreground="#858585" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- VS CODE TAB BAR -->
                <Border Grid.Row="1" Background="#252526" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="10,6">
                    <Grid>
                        <!-- VS CODE ACTIVE TAB PILL WITH BLUE TOP HIGHLIGHT (#007ACC) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1e1e1e" BorderBrush="#007acc" BorderThickness="0,3,0,0" Padding="10,6,8,6" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 " Foreground="#007acc" FontSize="12"/>
                                    <TextBlock Text="Chưa tiêu đề-1 *" Foreground="#ffffff" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="  ✕" Foreground="#858585" FontSize="12" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource VsRibbonBtn}" Content="+" Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- VS CODE MAIN CODE EDITOR PANE (#1E1E1E) MATCHING INDEX.JS & VIEW.HTML -->
                <Grid Grid.Row="2" Background="#1e1e1e">
                    <!-- 1. SINGLE EDIT MODE PANE (DEFAULT) -->
                    <Grid x:Name="GridEditPane" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- VS CODE LINE NUMBER GUTTER COLUMN -->
                        <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#2b2b2b" BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="TxtLineNumbersSv" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <TextBlock x:Name="TxtLineNumbers" Text="1" Padding="0,10,20,10"
                                           Foreground="#858585" FontSize="12.5" Block.LineHeight="24" Block.LineStackingStrategy="BlockLineHeight"
                                           FontFamily="Consolas, Cascadia Code, Courier New" HorizontalAlignment="Right"/>
                            </ScrollViewer>
                        </Border>

                        <!-- MULTI-LINE VS CODE TEXTAREA EDITOR -->
                        <TextBox x:Name="TxtEditorContent" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" 
                                 HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" 
                                 Background="#1e1e1e" Foreground="#d4d4d4" SelectionBrush="#264f78" CaretBrush="#ffffff"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="15" Block.LineHeight="24" Block.LineStackingStrategy="BlockLineHeight"
                                 Padding="16,10,16,10" BorderThickness="0"
                                 SelectionChanged="TxtEditorContent_SelectionChanged" TextChanged="TxtEditorContent_TextChanged"/>
                    </Grid>

                    <!-- 2. SPLIT COMPARE MODE PANE (SOURCE EN VS TARGET VI - MATCHING INDEX.JS COMPARISON MODE) -->
                    <Grid x:Name="GridComparePane" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SPLIT PANE: SOURCE TEXT EN (READ ONLY) -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#252526" Padding="10,4">
                                <TextBlock Text="VĂN BẢN GỐC (ENGLISH SOURCE)" Foreground="#858585" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#2b2b2b" BorderThickness="0,0,1,0">
                                    <ScrollViewer x:Name="TxtSourceLineNumbersSv" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <TextBlock x:Name="TxtSourceLineNumbers" Text="1" Padding="0,10,16,10"
                                                   Foreground="#666666" FontSize="12" Block.LineHeight="23" Block.LineStackingStrategy="BlockLineHeight"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" HorizontalAlignment="Right"/>
                                    </ScrollViewer>
                                </Border>
                                <TextBox x:Name="TxtSourceContent" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                         Background="#181818" Foreground="#9cdcfe" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="14" Block.LineHeight="23" Block.LineStackingStrategy="BlockLineHeight"
                                         Padding="14,10,14,10" BorderThickness="0"
                                         TextChanged="TxtSourceContent_TextChanged"/>
                            </Grid>
                        </Grid>

                        <!-- SPLIT DIVIDER -->
                        <Border Grid.Column="1" Background="#2d2d2d"/>

                        <!-- RIGHT SPLIT PANE: TARGET TEXT VI (EDITABLE) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#252526" Padding="10,4">
                                <TextBlock Text="BẢN DỊCH (VIETNAMESE TARGET)" Foreground="#4ec9b0" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#2b2b2b" BorderThickness="0,0,1,0">
                                    <ScrollViewer x:Name="TxtCompareLineNumbersSv" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <TextBlock x:Name="TxtCompareLineNumbers" Text="1" Padding="0,10,16,10"
                                                   Foreground="#858585" FontSize="12" Block.LineHeight="23" Block.LineStackingStrategy="BlockLineHeight"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" HorizontalAlignment="Right"/>
                                    </ScrollViewer>
                                </Border>
                                <TextBox x:Name="TxtCompareContent" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                         Background="#1e1e1e" Foreground="#d4d4d4" SelectionBrush="#264f78" CaretBrush="#ffffff"
                                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="14" Block.LineHeight="23" Block.LineStackingStrategy="BlockLineHeight"
                                         Padding="14,10,14,10" BorderThickness="0"
                                         SelectionChanged="TxtCompareContent_SelectionChanged" TextChanged="TxtCompareContent_TextChanged"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 3. PREVIEW PANE (PREVIEW MEDIAWIKI ARTICLE MATCHING INDEX.JS PREVIEW MODE) -->
                    <Grid x:Name="GridPreviewPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#252526" Padding="12,6">
                            <TextBlock Text="👁️ XEM TRƯỚC BÀI VIẾT WIKI (PREVIEW MODE)" Foreground="#007acc" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" Background="#1e1e1e" Padding="20">
                            <TextBlock x:Name="TxtPreviewContent" Foreground="#d4d4d4" FontSize="14" TextWrapping="Wrap" FontFamily="Segoe UI, Inter"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 4. PRESERVED DATAGRID TRANSLATION VIEW (SQLITE DATAGRID) -->
                    <DataGrid x:Name="DgTextMap" Visibility="Collapsed" AutoGenerateColumns="False" 
                              Background="#1e1e1e" RowBackground="#1e1e1e" 
                              BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2d2d2d" Foreground="#cccccc" FontSize="13" RowHeight="36">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="#858585"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#2d2d2d"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2a2d2e"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TEXTMAP ID" Binding="{Binding Id}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="VĂN BẢN GỐC (ENGLISH)" Binding="{Binding SourceText}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="BẢN DỊCH (TIẾNG VIỆT)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#3c3c3c" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                                <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="Transparent" Foreground="#4ec9b0" FontWeight="SemiBold"
                                                         BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>

        <!-- 3. VS CODE STATUS BAR AT BOTTOM (#007ACC) -->
        <Border Grid.Row="2" Background="#007acc" BorderBrush="#007acc" BorderThickness="0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- VS CODE LEFT STATUS ITEMS -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="💡 " FontSize="11"/>
                        <TextBlock Text="BotPass" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <!-- MODE SWITCHER DROPDOWN (EDIT, COMPARE, DATAGRID) -->
                    <ComboBox x:Name="CmbViewMode" Style="{StaticResource VsDarkComboStyle}" Width="135" Height="22" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center" SelectionChanged="CmbViewMode_SelectionChanged">
                        <ComboBoxItem Content="🔀 Soạn thảo" IsSelected="True" Tag="edit"/>
                        <ComboBoxItem Content="📊 So sánh (Compare)" Tag="compare"/>
                        <ComboBoxItem Content="📊 CSDL TextMap" Tag="datagrid"/>
                    </ComboBox>

                    <!-- TOGGLE PREVIEW BUTTON -->
                    <Border x:Name="BtnPreviewToggle" MouseLeftButtonDown="BtnPreviewToggle_MouseLeftButtonDown" Cursor="Hand" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👁️ " FontSize="11"/>
                            <TextBlock x:Name="TxtPreviewBtnLabel" Text="Xem trước" Foreground="#ffffff" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- STATUS TEXT -->
                    <TextBlock x:Name="TxtStatus" Text="Sẵn sàng" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- VS CODE RIGHT STATUS ITEMS -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="UTF-8" Foreground="#ffffff" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtCharCount" Text="0 ký tự" Foreground="#ffffff" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtCursorPos" Text="Ln 1, Col 1" Foreground="#ffffff" FontSize="12" Margin="0,0,16,0"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔗 " FontSize="11"/>
                        <TextBlock x:Name="TxtSyntaxMode" Text="Liên kết" Foreground="#ffffff" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
