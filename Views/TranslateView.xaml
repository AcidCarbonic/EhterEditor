                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Grid.Row="2" Text="Tạo Pipe" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="BtnToolBold" Click="BtnToolBold_Click" Style="{StaticResource VsRibbonBtn}">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="17"/>
                                                <RowDefinition Height="16"/>
                                            </Grid.RowDefinitions>
                                            <Viewbox Grid.Row="0" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M8 12h4.5M8 12V5h4.5a3.5 3.5 0 1 1 0 7M8 12v7h5.5a3.5 3.5 0 1 0 0-7h-1" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Grid.Row="2" Text="In đậm" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="BtnToolItalic" Click="BtnToolItalic_Click" Style="{StaticResource VsRibbonBtn}">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="17"/>
                                                <RowDefinition Height="16"/>
                                            </Grid.RowDefinitions>
                                            <Viewbox Grid.Row="0" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M8 19h2m0 0h2m-2 0l4-14m-2 0h2m0 0h2" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Grid.Row="2" Text="In nghiêng" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="CÔNG CỤ WIKI" Foreground="#707070" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Grid>

                            <!-- DIVIDER LINE | -->
                            <Border Width="1" Background="#3f3f46" Margin="20,10,20,10" VerticalAlignment="Stretch"/>

                            <!-- GROUP 3: THAY THẾ / TRỢ LÝ AI -->
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="11"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,10,0,0">
                                    <Button x:Name="BtnAssistant" Click="BtnAssistant_Click" Style="{StaticResource VsRibbonAiBtn}">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="17"/>
                                                <RowDefinition Height="16"/>
                                            </Grid.RowDefinitions>
                                            <Viewbox Grid.Row="0" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M12 3v3m0 12v3M3 12h3m12 0h3m-3.5-6.5l-2 2m-7 7l-2 2m0-11l2 2m7 7l2 2" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Grid.Row="2" Text="Trợ lý Dịch" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="THAY THẾ" Foreground="#707070" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Grid>

                            <!-- DIVIDER LINE | -->
                            <Border Width="1" Background="#3f3f46" Margin="20,10,20,10" VerticalAlignment="Stretch"/>

                            <!-- GROUP 4: HIỆU SUẤT -->
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="11"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0">
                                    <!-- ITEM 1: RAM -->
                                    <Border Padding="0,4,0,2" Height="63" VerticalAlignment="Top">
                                        <Grid Width="72" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="17"/>
                                                <RowDefinition Height="16"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" x:Name="TxtRamVal" Text="0 MB" Foreground="#007acc" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="RAM" Foreground="#aaaaaa" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- ITEM 2: CPU -->
                                    <Border Padding="0,4,0,2" Height="63" VerticalAlignment="Top">
                                        <Grid Width="64" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="17"/>
                                                <RowDefinition Height="16"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" x:Name="TxtCpuVal" Text="0 %" Foreground="#e2c08d" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="CPU" Foreground="#aaaaaa" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- ITEM 3: TAB -->
                                    <Border Padding="0,4,0,2" Height="63" VerticalAlignment="Top">
                                        <Grid Width="68" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="17"/>
                                                <RowDefinition Height="16"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" x:Name="TxtTabVal" Text="1 Tab" Foreground="#4ec9b0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="Đang mở" Foreground="#aaaaaa" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="HIỆU SUẤT" Foreground="#707070" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- VS CODE TAB BAR SEAMLESSLY FLUSH WITH TOOLBAR & EDITOR CEILING -->
                <Border Grid.Row="1" Height="35" Background="#252526" BorderBrush="#252526" BorderThickness="0" Padding="0">
                    <Grid Height="35">
                        <StackPanel x:Name="TabContainer" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <Border x:Name="FirstTabBorder" Background="#1e1e1e" BorderBrush="#007acc" BorderThickness="0,2,0,0" Padding="14,0,12,0" VerticalAlignment="Stretch" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📄 " Foreground="#007acc" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FirstTabText" Text="Chưa tiêu đề-1 *" Foreground="#ffffff" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FirstTabClose" Text="  ✕" Foreground="#999999" FontSize="11" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0" MouseLeftButtonDown="BtnCloseFirstTab_Click"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnAddTab" Style="{StaticResource VsTabAddBtn}" Content="+" Click="BtnAddTab_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- VS CODE MAIN CODE EDITOR PANE (#1E1E1E) MATCHING INDEX.JS & VIEW.HTML -->
                <Grid Grid.Row="2" Background="#1e1e1e">
                    <!-- 1. SINGLE EDIT MODE PANE (DEFAULT) -->
                    <Grid x:Name="GridEditPane" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- VS CODE LINE NUMBER GUTTER COLUMN -->
                        <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#2b2b2b" BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="TxtLineNumbersSv" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <TextBlock x:Name="TxtLineNumbers" Text="1" Padding="0,10,20,10"
                                           Foreground="#858585" FontSize="12.5" Block.LineHeight="24" Block.LineStackingStrategy="BlockLineHeight"
                                           FontFamily="Consolas, Cascadia Code, Courier New" HorizontalAlignment="Right"/>
                            </ScrollViewer>
                        </Border>

                        <!-- MULTI-LINE VS CODE TEXTAREA EDITOR WITH WIKITEXT / WIKILINK SYNTAX HIGHLIGHTING -->
                        <local:WikitextRichTextBox x:Name="TxtEditorContent" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" 
                                                   HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" 
                                                   Background="#1e1e1e" Foreground="#d4d4d4" SelectionBrush="#264f78" CaretBrush="#ffffff"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" FontSize="15" Block.LineHeight="24" Block.LineStackingStrategy="BlockLineHeight"
                                                   Padding="16,10,16,10" BorderThickness="0"
                                                   SelectionChanged="TxtEditorContent_SelectionChanged" TextChanged="TxtEditorContent_TextChanged"/>
                    </Grid>

                    <!-- 2. SPLIT COMPARE MODE PANE (SOURCE EN VS TARGET VI - MATCHING INDEX.JS COMPARISON MODE) -->
                    <Grid x:Name="GridComparePane" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SPLIT PANE: SOURCE TEXT EN (READ ONLY) -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#252526" Padding="10,4">
                                <TextBlock Text="VĂN BẢN GỐC (ENGLISH SOURCE)" Foreground="#858585" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#2b2b2b" BorderThickness="0,0,1,0">
                                    <ScrollViewer x:Name="TxtSourceLineNumbersSv" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <TextBlock x:Name="TxtSourceLineNumbers" Text="1" Padding="0,10,16,10"
                                                   Foreground="#666666" FontSize="12" Block.LineHeight="23" Block.LineStackingStrategy="BlockLineHeight"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" HorizontalAlignment="Right"/>
                                    </ScrollViewer>
                                </Border>
                                <TextBox x:Name="TxtSourceContent" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                         Background="#181818" Foreground="#9cdcfe" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="14" Block.LineHeight="23" Block.LineStackingStrategy="BlockLineHeight"
                                         Padding="14,10,14,10" BorderThickness="0"
                                         TextChanged="TxtSourceContent_TextChanged"/>
                            </Grid>
                        </Grid>

                        <!-- SPLIT DIVIDER -->
                        <Border Grid.Column="1" Background="#2d2d2d"/>

                        <!-- RIGHT SPLIT PANE: TARGET TEXT VI (EDITABLE) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#252526" Padding="10,4">
                                <TextBlock Text="BẢN DỊCH (VIETNAMESE TARGET)" Foreground="#4ec9b0" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#2b2b2b" BorderThickness="0,0,1,0">
                                    <ScrollViewer x:Name="TxtCompareLineNumbersSv" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <TextBlock x:Name="TxtCompareLineNumbers" Text="1" Padding="0,10,16,10"
                                                   Foreground="#858585" FontSize="12" Block.LineHeight="23" Block.LineStackingStrategy="BlockLineHeight"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" HorizontalAlignment="Right"/>
                                    </ScrollViewer>
                                </Border>
                                <TextBox x:Name="TxtCompareContent" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                         Background="#1e1e1e" Foreground="#d4d4d4" SelectionBrush="#264f78" CaretBrush="#ffffff"
                                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="14" Block.LineHeight="23" Block.LineStackingStrategy="BlockLineHeight"
                                         Padding="14,10,14,10" BorderThickness="0"
                                         SelectionChanged="TxtCompareContent_SelectionChanged" TextChanged="TxtCompareContent_TextChanged"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 3. PREVIEW PANE (PREVIEW MEDIAWIKI ARTICLE MATCHING INDEX.JS PREVIEW MODE) -->
                    <Grid x:Name="GridPreviewPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#252526" Padding="12,6">
                            <TextBlock Text="👁️ XEM TRƯỚC BÀI VIẾT WIKI (PREVIEW MODE)" Foreground="#007acc" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" Background="#1e1e1e" Padding="20">
                            <TextBlock x:Name="TxtPreviewContent" Foreground="#d4d4d4" FontSize="14" TextWrapping="Wrap" FontFamily="Segoe UI, Inter"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 4. PRESERVED DATAGRID TRANSLATION VIEW (SQLITE DATAGRID) -->
                    <DataGrid x:Name="DgTextMap" Visibility="Collapsed" AutoGenerateColumns="False" 
                              Background="#1e1e1e" RowBackground="#1e1e1e" 
                              BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2d2d2d" Foreground="#cccccc" FontSize="13" RowHeight="36">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="#858585"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#2d2d2d"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2a2d2e"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TEXTMAP ID" Binding="{Binding Id}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="VĂN BẢN GỐC (ENGLISH)" Binding="{Binding SourceText}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="BẢN DỊCH (TIẾNG VIỆT)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#3c3c3c" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                                <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="Transparent" Foreground="#4ec9b0" FontWeight="SemiBold"
                                                         BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>

        <!-- 3. VS CODE STATUS BAR AT BOTTOM (#007ACC) -->
        <Border Grid.Row="2" Background="#007acc" BorderBrush="#007acc" BorderThickness="0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- VS CODE LEFT STATUS ITEMS -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- BOTPASS STATUS BADGE (GREEN CHECKMARK CIRCLE BADGE) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Fill="#2ecc71" Width="14" Height="14"/>
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 6.5 12.5 L 10 16 L 17.5 8.5" Stroke="#ffffff" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <TextBlock Text="BotPass" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- MODE SWITCHER DROPDOWN (TRANSPARENT - NO DARK BOX FRAME) -->
                    <ComboBox x:Name="CmbViewMode" Style="{StaticResource VsStatusComboStyle}" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center" Loaded="CmbViewMode_Loaded" SelectionChanged="CmbViewMode_SelectionChanged">
                        <ComboBoxItem Content="🔀 Soạn thảo" IsSelected="True" Tag="edit"/>
                        <ComboBoxItem Content="📊 So sánh (Compare)" Tag="compare"/>
                        <ComboBoxItem Content="📊 CSDL TextMap" Tag="datagrid"/>
                    </ComboBox>

                    <!-- TOGGLE PREVIEW BUTTON -->
                    <Border x:Name="BtnPreviewToggle" MouseLeftButtonDown="BtnPreviewToggle_MouseLeftButtonDown" Cursor="Hand" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👁️ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPreviewBtnLabel" Text="Xem trước" Foreground="#ffffff" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- STATUS TEXT -->
                    <TextBlock x:Name="TxtStatus" Text="" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- VS CODE RIGHT STATUS ITEMS -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="UTF-8" Foreground="#ffffff" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCharCount" Text="0 ký tự" Foreground="#ffffff" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCursorPos" Text="Ln 1, Col 1" Foreground="#ffffff" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <Border x:Name="BtnSyntaxModeToggle" 
                            MouseLeftButtonDown="BtnSyntaxModeToggle_MouseLeftButtonDown" 
                            Cursor="Hand" 
                            Background="Transparent" 
                            CornerRadius="3" 
                            Padding="8,2" 
                            VerticalAlignment="Center" 
                            ToolTip="Chuyển đổi chế độ cú pháp (WikiLink / WikiText)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSyntaxIcon" Text="🔗 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSyntaxMode" Text="WikiLink" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- OVERLAY MODAL CONTAINER LAYER (Z-INDEX TOP - SPANS ENTIRE VIEW) -->
        <Grid x:Name="GridModalOverlay" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#aa000000" Panel.ZIndex="9999">
            <!-- 1. MODAL CÀI ĐẶT (VS CODE LEFT SIDEBAR VERTICAL TAB LAYOUT - 1180x744) -->
            <Border x:Name="BorderModalSettings" Visibility="Collapsed" 
                    Width="1180" Height="744" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Background="#1e1e24" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ROW 0: TOP HEADER BAR (Title + Close) -->
                    <Border Grid.Row="0" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="24,10,8,10" Background="#18181c">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Title & Subtitle -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Cài đặt hệ thống" Foreground="#ffffff" FontSize="18.5" FontWeight="Bold"/>
                                <TextBlock Text="Thiết lập tham số ứng dụng &amp; hệ thống dịch thuật Ether-Editor" Foreground="#aaaaaa" FontSize="12.5" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Close Button (Shifted flush to the right edge) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                                <Button Click="BtnCloseModal_Click" Style="{StaticResource VsSquareCloseBtn}" ToolTip="Đóng cài đặt" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 1: MAIN BODY (LEFT SIDEBAR NAVIGATION MENU + RIGHT CONTENT PANES) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDEBAR NAVIGATION MENU (DISCORD STYLE ACCORDION TREES) -->
                        <Border Grid.Column="0" Background="#111214" BorderBrush="#232428" BorderThickness="0,0,1,0" Padding="16,14,14,14">
                            <Grid x:Name="SidebarNavContainer">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,2,0,0">
                                        <!-- CATEGORY 1: HỆ THỐNG -->
                                        <Border x:Name="HeaderGroupSystem" Cursor="Hand" MouseLeftButtonDown="HeaderGroupSystem_MouseLeftButtonDown" Background="Transparent" Padding="2,4" Margin="0,0,0,6">
