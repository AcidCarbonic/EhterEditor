<UserControl x:Class="EtherEditorNative.Views.TranslateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EtherEditorNative.Views"
             Background="#1e1e1e"
             FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- GLOBAL TEXTBOX STYLE (BRIGHT WHITE CARET ON DARK BACKGROUND) -->
        <Style TargetType="TextBox">
            <Setter Property="CaretBrush" Value="#ffffff"/>
            <Setter Property="SelectionBrush" Value="#264f78"/>
        </Style>

        <!-- GLOBAL DARK DATAGRID COLUMN HEADER STYLE -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="headerBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE DARK CONTEXT MENU STYLE -->
        <Style x:Key="VsContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE DARK MENUITEM STYLE -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#04395e"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE DARK SEPARATOR STYLE -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Margin" Value="-4,4,-4,4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}" HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DISCORD SIDEBAR SUB-ITEM BUTTON STYLE -->
        <Style x:Key="VsTopTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#949ba4"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SLEEK DARK DISCORD-STYLE SCROLLBAR REPEAT BUTTON -->
        <Style x:Key="ScrollTransparentRepeatBtn" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VERTICAL SCROLLBAR TEMPLATE -->
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" IsDirectionReversed="True" HorizontalAlignment="Right">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollTransparentRepeatBtn}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Width="8" MinHeight="36">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="thumbBorder" Background="#3a3c42" CornerRadius="4" HorizontalAlignment="Right" Width="8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="thumbBorder" Property="Background" Value="#4e5058"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="thumbBorder" Property="Background" Value="#5d6069"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollTransparentRepeatBtn}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- HORIZONTAL SCROLLBAR TEMPLATE -->
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" IsDirectionReversed="False" VerticalAlignment="Bottom">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollTransparentRepeatBtn}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Height="8" MinWidth="36">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="thumbBorder" Background="#3a3c42" CornerRadius="4" VerticalAlignment="Bottom" Height="8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="thumbBorder" Property="Background" Value="#4e5058"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="thumbBorder" Property="Background" Value="#5d6069"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollTransparentRepeatBtn}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DARK COMBOBOX ITEM STYLE -->
        <Style x:Key="VsDarkComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#d4d4d4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" 
                                CornerRadius="4" 
                                Margin="2,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#37373d"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#04395e"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DARK COMBOBOX TOGGLE BUTTON STYLE -->
        <Style x:Key="VsComboToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="templateRoot" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="true">
                            <Grid HorizontalAlignment="Right" Width="30">
                                <Path x:Name="arrow" 
                                      Data="M 0 0 L 4 4 L 8 0 Z" 
                                      Fill="#aaaaaa" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" 
                                      Stretch="Uniform" 
                                      Width="8" Height="5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="templateRoot" Property="Background" Value="#2d2d30"/>
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#007acc"/>
                                <Setter TargetName="arrow" Property="Fill" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="templateRoot" Property="Background" Value="#2d2d30"/>
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#007acc"/>
                                <Setter TargetName="arrow" Property="Fill" Value="#007acc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DARK COMBOBOX MAIN STYLE -->
        <Style x:Key="VsLightComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,0,30,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource VsDarkComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Style="{StaticResource VsComboToggleBtnStyle}"/>

                            <ContentPresenter x:Name="contentPresenter" 
                                              IsHitTestVisible="false" 
                                              Margin="{TemplateBinding Padding}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="true" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Margin="0,2,0,0" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide" 
                                   VerticalOffset="2"
                                   MinWidth="{Binding ElementName=mainGrid, Path=ActualWidth}">
                                <Border x:Name="dropDownBorder" 
                                        Background="#1e1e24" 
                                        BorderBrush="#3c3c3c" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="2"
                                        MinWidth="{Binding ElementName=mainGrid, Path=ActualWidth}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" MaxHeight="240" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VsLightInputStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="34"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#007acc"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Background" Value="#1c2128"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#525866"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VsToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="switchBorder" Width="38" Height="20" CornerRadius="10" Background="#3c3c3c" Margin="0,0,8,0" Padding="2">
                                <Ellipse x:Name="switchThumb" Width="16" Height="16" Fill="#ffffff" HorizontalAlignment="Left"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="switchBorder" Property="Background" Value="#007acc"/>
                                <Setter TargetName="switchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VsLightPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#007acc"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1177bb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VsLightSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#383838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GLOSSARY PILL ACTION BUTTON STYLES (SUBTLE DARK COLORS) -->
        <Style x:Key="VsGlossaryEditBtn" TargetType="Button">
            <Setter Property="Background" Value="#102538"/>
            <Setter Property="Foreground" Value="#38bdf8"/>
            <Setter Property="BorderBrush" Value="#1e3a5f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#173c60"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38bdf8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0c1d2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VsGlossaryDeleteBtn" TargetType="Button">
            <Setter Property="Background" Value="#33181b"/>
            <Setter Property="Foreground" Value="#f87171"/>
            <Setter Property="BorderBrush" Value="#522329"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4a2227"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#f87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#241013"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SQUARE CLOSE BUTTON STYLE (BOLD SVG CROSS + 1:1 SQUARE CONTAINER) -->
        <Style x:Key="VsSquareCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Đóng"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Width="32" Height="32">
                            <Path x:Name="icon" 
                                  Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                  Fill="#999999" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2d2f36"/>
                                <Setter TargetName="icon" Property="Fill" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3a3c45"/>
                                <Setter TargetName="icon" Property="Fill" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- VS CODE SUB-MENU BUTTON STYLE -->
        <Style x:Key="VsMenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3c3c3c"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE RIBBON VERTICAL BUTTON STYLE -->
        <Style x:Key="VsRibbonBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="63"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE AI ASSISTANT BLUE BUTTON STYLE -->
        <Style x:Key="VsRibbonAiBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#007acc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="63"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#3399ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ASSISTANT TAB BUTTON STYLE -->
        <Style x:Key="AssistantTabBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#222228"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE SIDEBAR BUTTON -->
        <Style x:Key="VsSidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007acc"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS CODE TAB ADD BUTTON STYLE (FLUSH VERTICALLY BETWEEN TOOLBAR BOTTOM & EDITOR CEILING) -->
        <Style x:Key="VsTabAddBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2a2d2e"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007acc"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INTEGRATED INPUT ACTION BUTTON (FILLS RIGHT SECTION OF INPUT BOX FLUSH - MATCHING USER SPECIFICATION) -->
        <Style x:Key="VsInputIntegratedBtn" TargetType="Button">
            <Setter Property="Background" Value="#484d57"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007acc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INTEGRATED INPUT CONTAINER BORDER STYLE WITH BLUE FOCUS HIGHLIGHT -->
        <Style x:Key="VsInputContainerBorder" TargetType="Border">
            <Setter Property="Background" Value="#2d3036"/>
            <Setter Property="BorderBrush" Value="#3c3f47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#007acc"/>
                    <Setter Property="Background" Value="#252830"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- VS CODE DARK COMBOBOX TOGGLE BUTTON -->
        <ControlTemplate x:Key="VsComboToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#858585" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#007acc"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#ffffff"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#007acc"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#ffffff"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- VS CODE DARK COMBOBOX STYLE ALIAS -->
        <Style x:Key="VsDarkComboStyle" TargetType="ComboBox" BasedOn="{StaticResource VsLightComboStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- VS CODE STATUS BAR TRANSPARENT COMBOBOX STYLE (NO DARK BOX FRAME) -->
        <Style x:Key="VsStatusComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource VsDarkComboItemStyle}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid" VerticalAlignment="Center">
                            <ToggleButton x:Name="toggleButton" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" BorderThickness="0" Padding="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              Margin="2,0,14,0" 
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Custom" 
                                   PlacementTarget="{Binding ElementName=mainGrid}"
                                   PopupAnimation="Fade">
                                <Border x:Name="dropDownBorder" 
                                        Background="#252526" 
                                        BorderBrush="#3c3c3c" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Margin="0" 
                                        HorizontalAlignment="Left"
                                        MinWidth="170">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Background="#252526" Foreground="#ffffff" MaxHeight="220">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 1. VS CODE TOP SUB-MENU BAR (#252526) -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT VS CODE SUB-MENU ITEMS -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnFileMenu" Style="{StaticResource VsMenuBtn}" Content="Tệp" Click="BtnFileMenu_Click"/>
                    <Button x:Name="BtnSearchMenu" Style="{StaticResource VsMenuBtn}" Content="Tra cứu" Click="BtnSearchMenu_Click"/>
                    <Button x:Name="BtnGlossaryMenu" Style="{StaticResource VsMenuBtn}" Content="Từ điển ưu tiên" Click="BtnGlossaryMenu_Click"/>
                    <Button x:Name="BtnSettingsMenu" Style="{StaticResource VsMenuBtn}" Content="Cài đặt" Click="BtnSettingsMenu_Click"/>
                </StackPanel>

                <!-- RIGHT VS CODE FILE SWITCHER PILL (EXTENDED WIDTH & DROPDOWN POPUP) -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnFilePickerPill" 
                                  IsChecked="{Binding IsOpen, ElementName=PopupSavesFiles, Mode=TwoWay}"
                                  Width="360" Height="26"
                                  Padding="12,0"
                                  Cursor="Hand"
                                  Background="#2d2d30"
                                  BorderBrush="#3e3e42"
                                  BorderThickness="1"
                                  FocusVisualStyle="{x:Null}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="pillBorder" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="pillBorder" Property="Background" Value="#37373d"/>
                                        <Setter TargetName="pillBorder" Property="BorderBrush" Value="#007acc"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="pillBorder" Property="Background" Value="#37373d"/>
                                        <Setter TargetName="pillBorder" Property="BorderBrush" Value="#007acc"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Coolicons Folder/File vector icon -->
                            <Path Grid.Column="0" Data="M6 2a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6H6zm7 1.5L18.5 9H13V3.5zM6 4h5v6h6v10H6V4z" 
                                  Fill="#38bdf8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="saves / " Foreground="#858585" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDisplayFileName" Text="kết_quả.mediawiki" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Path Grid.Column="2" Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#858585" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </ToggleButton>

                    <!-- DROPDOWN POPUP LISTING FILES IN SAVES -->
                    <Popup x:Name="PopupSavesFiles" 
                           PlacementTarget="{Binding ElementName=BtnFilePickerPill}" 
                           Placement="Bottom" 
                           AllowsTransparency="True" 
                           StaysOpen="False" 
                           Opened="PopupSavesFiles_Opened"
                           PopupAnimation="Fade" 
                           HorizontalOffset="0" 
                           VerticalOffset="4">
                        <Border Background="#1e1e24" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="6" Width="{Binding ActualWidth, ElementName=BtnFilePickerPill}" MaxHeight="320" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.65"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Border Grid.Row="0" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="12,8">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M6 2a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6H6zm7 1.5L18.5 9H13V3.5zM6 4h5v6h6v10H6V4z" Fill="#38bdf8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Số tệp" Foreground="#ffffff" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSavesFileCount" Text="0 tệp" Foreground="#858585" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- SCROLLABLE LIST OF FILES -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260">
                                    <StackPanel x:Name="StackSavesFileList" Margin="4"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. VS CODE MAIN EDITOR LAYOUT (SPLIT INTO SIDEBAR & MAIN AREA) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- VS CODE LEFT SIDEBAR (#252526) -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#2d2d2d" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP SIDEBAR HEADER BAR (ALWAYS VISIBLE) -->
                    <Border x:Name="BorderSidebarHeader" Grid.Row="0" Padding="14,12,12,12">
                        <Grid>
                            <TextBlock x:Name="TxtSidebarTitle" Text="QUY TRÌNH XUẤT BẢN" Foreground="#cccccc" FontSize="11.5" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <Button x:Name="BtnToggleSidebar" Style="{StaticResource VsSidebarBtn}" Width="26" Height="24" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnToggleSidebar_Click" ToolTip="Thu gọn quy trình xuất bản">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="PathToggleSidebar" Data="M 12 5 L 6 12 L 12 19 M 18 5 L 12 12 L 18 19" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>


                    <!-- SCROLLABLE SIDEBAR CONTENT (COLLAPSED WHEN SIDEBAR IS COLLAPSED) -->
                    <ScrollViewer x:Name="SidebarScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,0,14,14">
                            <!-- BƯỚC 1: CHỌN GAME -->
                            <TextBlock Text="1. CHỌN GAME:" Foreground="#858585" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbGameSelect" Style="{StaticResource VsDarkComboStyle}" SelectedIndex="0" Margin="0,0,0,14" SelectionChanged="CmbGameSelect_SelectionChanged">
                                <ComboBoxItem Content="Honkai: Star Rail" IsSelected="True" Tag="hsr"/>
                                <ComboBoxItem Content="Genshin Impact" Tag="genshin"/>
                                <ComboBoxItem Content="Zenless Zone Zero" Tag="zzz"/>
                            </ComboBox>

                            <!-- BƯỚC 2: TIÊU ĐỀ ANH -->
                            <TextBlock Text="2. TIÊU ĐỀ ANH (SOURCE):" Foreground="#858585" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource VsInputContainerBorder}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTitleEn" Background="Transparent" Foreground="#ffffff" CaretBrush="#ffffff" BorderThickness="0" FontSize="13" Padding="12,0,6,0" VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="TxtTitleEnPlaceholder" Text="Tên bài Anh..." Foreground="#777777" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtTitleEn}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button x:Name="BtnFetchEn" Grid.Column="1" Click="BtnFetchEn_Click" Style="{StaticResource VsInputIntegratedBtn}" ToolTip="Tải từ Wiki EN">
                                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 8 2 L 8 10 M 5 7 L 8 10 L 11 7 M 3 13 L 13 13 L 13 15 L 3 15 Z" Stroke="#ffffff" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- BƯỚC 3: TIÊU ĐỀ VIỆT -->
                            <TextBlock Text="3. TIÊU ĐỀ VIỆT (TARGET):" Foreground="#858585" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource VsInputContainerBorder}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTitleVi" Background="Transparent" Foreground="#ffffff" CaretBrush="#ffffff" BorderThickness="0" FontSize="13" Padding="12,0,6,0" VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="TxtTitleViPlaceholder" Text="Tên bài Việt..." Foreground="#777777" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtTitleVi}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button x:Name="BtnPublishVi" Grid.Column="1" Click="BtnPublishVi_Click" Style="{StaticResource VsInputIntegratedBtn}" ToolTip="Đăng bài lên Wiki VI / Lưu tệp">
                                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 8 11 L 8 3 M 5 6 L 8 3 L 11 6 M 3 13 L 13 13 L 13 15 L 3 15 Z" Stroke="#ffffff" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- SECTION 2: THAY ĐỔI GẦN ĐÂY ON WIKI -->
                            <Border BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 5h-2v6h5v-2h-3V7z" Fill="#858585" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="THAY ĐỔI GẦN ĐÂY" Foreground="#858585" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSyncTime" Text="FS: 5m 52s" Foreground="#858585" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="Lỗi tải hoạt động Wiki" Foreground="#f14c4c" FontSize="12" Margin="0,4,0,12"/>

                                        <Border Background="#1e1e1e" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="March 7th" Foreground="#cccccc" FontSize="12.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Cập nhật bản dịch 4.4 • 2 phút trước" Foreground="#858585" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1e1e1e" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Kafka/Dialogue" Foreground="#cccccc" FontSize="12.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Sửa thuật ngữ • 15 phút trước" Foreground="#858585" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1e1e1e" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="5" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="Dan Heng/Story" Foreground="#cccccc" FontSize="12.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Thêm dòng thoại mới • 1 giờ trước" Foreground="#858585" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: VS CODE RIBBON & CODE EDITOR PANE (#1E1E1E) -->
            <Grid Grid.Column="1" Background="#1e1e1e">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- VS CODE RIBBON TOOLBAR (#252526) WITH EXPLICIT 107PX FRAME HEIGHT -->
