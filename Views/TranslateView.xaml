<UserControl x:Class="EtherEditorNative.Views.TranslateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0f1115">
    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#2b2d31"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#18191f" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#2b2d31" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ComboBox x:Name="CmbGameSelect" Width="180" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" SelectionChanged="CmbGameSelect_SelectionChanged">
                        <ComboBoxItem Content="Honkai: Star Rail" IsSelected="True"/>
                        <ComboBoxItem Content="Genshin Impact"/>
                        <ComboBoxItem Content="Zenless Zone Zero"/>
                    </ComboBox>

                    <TextBox x:Name="TxtSearchInput" Width="300" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" 
                             Padding="8,0" Background="#111214" Foreground="White" BorderBrush="#2b2d31" 
                             Text="Nhập từ khóa tìm kiếm TextMap..." KeyDown="TxtSearchInput_KeyDown"/>

                    <Button Content="🔍 Tìm kiếm" Style="{StaticResource PrimaryBtn}" Click="BtnSearch_Click" Height="32" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="➕ Thêm Thuật Ngữ" Style="{StaticResource ToolBtn}" Height="32"/>
                    <Button Content="💾 Lưu JSON" Style="{StaticResource PrimaryBtn}" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TRANSLATION DATAGRID -->
        <Border Grid.Row="1" Background="#18191f" CornerRadius="8" BorderBrush="#2b2d31" BorderThickness="1">
            <DataGrid x:Name="DgTextMap" AutoGenerateColumns="False" 
                      Background="Transparent" RowBackground="Transparent" 
                      BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2b2d31" Foreground="#dbdee1" FontSize="13">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#111214"/>
                        <Setter Property="Foreground" Value="#949ba4"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#2b2d31"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TEXTMAP ID" Binding="{Binding Id}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="VĂN BẢN GỐC (ENGLISH)" Binding="{Binding SourceText}" Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="BẢN DỊCH (TIẾNG VIỆT)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#111214" Foreground="#57F287" 
                                         BorderBrush="#2b2d31" Padding="6,4" FontSize="13"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- STATUS BAR -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="Đã nạp 100 câu dịch thuật mẫu" Foreground="#949ba4" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
