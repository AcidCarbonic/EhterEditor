                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#252526" Padding="12,6">
                            <TextBlock Text="👁️ XEM TRƯỚC BÀI VIẾT WIKI (PREVIEW MODE)" Foreground="#007acc" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" Background="#1e1e1e" Padding="20">
                            <TextBlock x:Name="TxtPreviewContent" Foreground="#d4d4d4" FontSize="14" TextWrapping="Wrap" FontFamily="Segoe UI, Inter"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 4. PRESERVED DATAGRID TRANSLATION VIEW (SQLITE DATAGRID) -->
                    <DataGrid x:Name="DgTextMap" Visibility="Collapsed" AutoGenerateColumns="False" 
                              Background="#1e1e1e" RowBackground="#1e1e1e" 
                              BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2d2d2d" Foreground="#cccccc" FontSize="13" RowHeight="36">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="#858585"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#2d2d2d"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2a2d2e"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TEXTMAP ID" Binding="{Binding Id}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="VĂN BẢN GỐC (ENGLISH)" Binding="{Binding SourceText}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="BẢN DỊCH (TIẾNG VIỆT)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#3c3c3c" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                                <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="Transparent" Foreground="#4ec9b0" FontWeight="SemiBold"
                                                         BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>

        <!-- 3. VS CODE STATUS BAR AT BOTTOM (#007ACC) -->
        <Border Grid.Row="2" Background="#007acc" BorderBrush="#007acc" BorderThickness="0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- VS CODE LEFT STATUS ITEMS -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- BOTPASS STATUS BADGE (GREEN CHECKMARK CIRCLE BADGE) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Fill="#2ecc71" Width="14" Height="14"/>
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 6.5 12.5 L 10 16 L 17.5 8.5" Stroke="#ffffff" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <TextBlock Text="BotPass" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- MODE SWITCHER DROPDOWN (TRANSPARENT - NO DARK BOX FRAME) -->
                    <ComboBox x:Name="CmbViewMode" Style="{StaticResource VsStatusComboStyle}" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center" Loaded="CmbViewMode_Loaded" SelectionChanged="CmbViewMode_SelectionChanged">
                        <ComboBoxItem Content="🔀 Soạn thảo" IsSelected="True" Tag="edit"/>
                        <ComboBoxItem Content="📊 So sánh (Compare)" Tag="compare"/>
                        <ComboBoxItem Content="📊 CSDL TextMap" Tag="datagrid"/>
                    </ComboBox>

                    <!-- TOGGLE PREVIEW BUTTON -->
                    <Border x:Name="BtnPreviewToggle" MouseLeftButtonDown="BtnPreviewToggle_MouseLeftButtonDown" Cursor="Hand" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👁️ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPreviewBtnLabel" Text="Xem trước" Foreground="#ffffff" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- STATUS TEXT -->
                    <TextBlock x:Name="TxtStatus" Text="" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- VS CODE RIGHT STATUS ITEMS -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="UTF-8" Foreground="#ffffff" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCharCount" Text="0 ký tự" Foreground="#ffffff" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCursorPos" Text="Ln 1, Col 1" Foreground="#ffffff" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <Border x:Name="BtnSyntaxModeToggle" 
                            MouseLeftButtonDown="BtnSyntaxModeToggle_MouseLeftButtonDown" 
                            Cursor="Hand" 
                            Background="Transparent" 
                            CornerRadius="3" 
                            Padding="8,2" 
                            VerticalAlignment="Center" 
                            ToolTip="Chuyển đổi chế độ cú pháp (WikiLink / WikiText)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSyntaxIcon" Text="🔗 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSyntaxMode" Text="WikiLink" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <!-- OVERLAY MODAL CONTAINER LAYER (Z-INDEX TOP - SPANS ENTIRE VIEW) -->
        <Grid x:Name="GridModalOverlay" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#aa000000" Panel.ZIndex="9999">
            <!-- 1. MODAL CÀI ĐẶT (SETTINGS MODAL) -->
            <Border x:Name="BorderModalSettings" Visibility="Collapsed" 
                    Width="520" Height="400" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Background="#1e1e1e" BorderBrush="#007acc" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙️ " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="CÀI ĐẶT HỆ THỐNG &amp; FANDOM WIKI API" Foreground="#ffffff" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Click="BtnCloseModal_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="14" Cursor="Hand" Content="✕"/>
                    </Grid>

                    <!-- BODY -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="1. URL Endpoint Fandom MediaWiki API:" Foreground="#cccccc" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource VsInputContainerBorder}" Margin="0,0,0,14">
                            <TextBox x:Name="TxtSettingWikiApiUrl" Text="https://honkai-star-rail.fandom.com/vi/api.php" Background="Transparent" Foreground="#ffffff" CaretBrush="#ffffff" BorderThickness="0" FontSize="13" Padding="10,6"/>
                        </Border>

                        <TextBlock Text="2. Fandom Botpass Username / Email:" Foreground="#cccccc" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource VsInputContainerBorder}" Margin="0,0,0,14">
                            <TextBox x:Name="TxtSettingBotUser" Text="EtherEditorBot@fandom" Background="Transparent" Foreground="#ffffff" CaretBrush="#ffffff" BorderThickness="0" FontSize="13" Padding="10,6"/>
                        </Border>

                        <TextBlock Text="3. API Token / User Password:" Foreground="#cccccc" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource VsInputContainerBorder}" Margin="0,0,0,14">
                            <PasswordBox x:Name="TxtSettingBotPass" Password="••••••••••••••••" Background="Transparent" Foreground="#ffffff" CaretBrush="#ffffff" BorderThickness="0" FontSize="13" Padding="10,6"/>
                        </Border>

                        <CheckBox x:Name="ChkSettingAutoTranslate" Content="Tự động chuẩn hóa Thuật ngữ khi mở bài viết" Foreground="#cccccc" FontSize="12.5" IsChecked="True" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- FOOTER -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCloseModal_Click" Content="Hủy" Style="{StaticResource VsMenuBtn}" Width="80" Margin="0,0,10,0"/>
                        <Button Click="BtnSaveSettings_Click" Content="Lưu Cài Đặt" Style="{StaticResource VsInputIntegratedBtn}" Width="110" Height="32"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MODAL TỪ ĐIỂN ƯU TIÊN (PRIORITY GLOSSARY MODAL) -->
            <Border x:Name="BorderModalGlossary" Visibility="Collapsed" 
                    Width="680" Height="480" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Background="#1e1e1e" BorderBrush="#007acc" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📚 " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="QUẢN LÝ TỪ ĐIỂN THUẬT NGỮ ƯU TIÊN (PRIORITY GLOSSARY)" Foreground="#ffffff" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Click="BtnCloseModal_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="14" Cursor="Hand" Content="✕"/>
                    </Grid>

                    <!-- ADD TERM BAR -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource VsInputContainerBorder}" Margin="0,0,6,0">
                            <TextBox x:Name="TxtNewTermEn" Background="Transparent" Foreground="#ffffff" CaretBrush="#ffffff" BorderThickness="0" FontSize="13" Padding="8,6" ToolTip="Thuật ngữ tiếng Anh"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource VsInputContainerBorder}" Margin="0,0,6,0">
                            <TextBox x:Name="TxtNewTermVi" Background="Transparent" Foreground="#ffffff" CaretBrush="#ffffff" BorderThickness="0" FontSize="13" Padding="8,6" ToolTip="Thuật ngữ tiếng Việt"/>
                        </Border>
                        <Button Grid.Column="2" Click="BtnAddGlossaryTerm_Click" Content="+ Thêm" Style="{StaticResource VsInputIntegratedBtn}" Height="32"/>
                    </Grid>

                    <!-- GLOSSARY LIST -->
                    <DataGrid x:Name="DgGlossaryList" Grid.Row="2" AutoGenerateColumns="False" 
                              Background="#252526" RowBackground="#1e1e1e" 
                              BorderThickness="1" BorderBrush="#3c3c3c" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2d2d2d" Foreground="#cccccc" FontSize="13" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="THUẬT NGỮ ANH (SOURCE)" Binding="{Binding SourceText}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="BẢN DỊCH VIỆT (TARGET)" Binding="{Binding TargetText}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="THAO TÁC" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Xóa" Click="BtnDeleteGlossaryTerm_Click" Foreground="#f14c4c" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- FOOTER -->
                    <StackPanel Grid.Row="3" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCloseModal_Click" Content="Đóng" Style="{StaticResource VsMenuBtn}" Width="80"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. MODAL TRA CỨU THUẬT NGỮ & WIKI (LOOKUP MODAL) -->
            <Border x:Name="BorderModalLookup" Visibility="Collapsed" 
                    Width="720" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Background="#1e1e1e" BorderBrush="#007acc" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍 " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="TRA CỨU THUẬT NGỮ &amp; BÀI VIẾT FANDOM WIKI" Foreground="#ffffff" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Click="BtnCloseModal_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="14" Cursor="Hand" Content="✕"/>
                    </Grid>

                    <!-- SEARCH BAR -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource VsInputContainerBorder}" Margin="0,0,8,0">
                            <TextBox x:Name="TxtLookupQuery" KeyDown="TxtLookupQuery_KeyDown" Background="Transparent" Foreground="#ffffff" CaretBrush="#ffffff" BorderThickness="0" FontSize="13" Padding="10,6" ToolTip="Nhập từ khóa tra cứu..."/>
                        </Border>
                        <Button Grid.Column="1" Click="BtnPerformLookup_Click" Content="🔍 Tra Cứu" Style="{StaticResource VsInputIntegratedBtn}" Height="32"/>
                    </Grid>

                    <!-- LOOKUP RESULTS -->
                    <DataGrid x:Name="DgLookupResults" Grid.Row="2" AutoGenerateColumns="False" 
                              Background="#252526" RowBackground="#1e1e1e" 
                              BorderThickness="1" BorderBrush="#3c3c3c" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2d2d2d" Foreground="#cccccc" FontSize="13" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GAME" Binding="{Binding GameId}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="TÊN TIẾNG ANH" Binding="{Binding SourceText}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="TÊN TIẾNG VIỆT" Binding="{Binding TargetText}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="CHÈN" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Chèn [[...]]" Click="BtnInsertLookupResult_Click" Foreground="#4ec9b0" Background="#2d2d2d" BorderThickness="0" Padding="6,2" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- FOOTER -->
                    <StackPanel Grid.Row="3" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCloseModal_Click" Content="Đóng" Style="{StaticResource VsMenuBtn}" Width="80"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
