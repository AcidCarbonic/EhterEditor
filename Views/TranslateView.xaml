                                            <ComboBoxItem Content="Bồ Đào Nha (pt)" Tag="pt"/>
                                            <ComboBoxItem Content="Tiếng Nga (ru)" Tag="ru"/>
                                            <ComboBoxItem Content="Tiếng Thái (th)" Tag="th"/>
                                            <ComboBoxItem Content="Thổ Nhĩ Kỳ (tr)" Tag="tr"/>
                                            <ComboBoxItem Content="Tiếng Trung Giản thể (zhs)" Tag="zhs"/>
                                            <ComboBoxItem Content="Tiếng Trung Phồn thể (zht)" Tag="zht"/>
                                            <ComboBoxItem Content="Tiếng Việt (vi)" Tag="vi"/>
                                        </ComboBox>
                                        <Button x:Name="BtnAddInterwikiLang" Click="BtnAddInterwikiLang_Click" Style="{StaticResource VsLightPrimaryBtn}" Height="28" Padding="14,0" Content="Thêm"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Background="#141416" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ngôn Ngữ" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                    <TextBlock Grid.Column="1" Text="Liên Kết Interwiki" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="Thao tác" Foreground="#858585" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <StackPanel x:Name="StackInterwikiRows"/>
                            </ScrollViewer>
                            <Border Grid.Row="3" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Padding="20,10">
                                <Grid>
                                    <TextBlock x:Name="TxtInterwikiStatus" Text="Hiển thị 0 liên kết Interwiki" Foreground="#858585" FontSize="12" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnApplyAllInterwiki" Click="BtnApplyAllInterwiki_Click" Style="{StaticResource VsLightPrimaryBtn}" Height="30" Padding="20,0" HorizontalAlignment="Right" Content="Áp dụng vào bài viết"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- PANE 4: INFOBOX -->
                        <Grid x:Name="PaneInfobox" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#141416" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="340"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dòng" Foreground="#858585" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Tham Số Infobox EN" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="Soạn Thảo VI (DB + AI Gợi ý)" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                    <TextBlock Grid.Column="3" Text="Thao tác" Foreground="#858585" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <StackPanel x:Name="StackInfoboxRows"/>
                            </ScrollViewer>
                            <Border Grid.Row="2" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Padding="20,10">
                                <Grid>
                                    <TextBlock x:Name="TxtInfoboxStatus" Text="Hiển thị 0 kết quả" Foreground="#858585" FontSize="12" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnApplyAllInfobox" Click="BtnApplyAllInfobox_Click" Style="{StaticResource VsLightPrimaryBtn}" Height="30" Padding="20,0" HorizontalAlignment="Right" Content="Áp dụng tất cả"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- PANE 5: TEMPLATE -->
                        <Grid x:Name="PaneTemplate" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#141416" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="340"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dòng" Foreground="#858585" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Bản Mẫu &amp; Tham Số EN" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="Soạn Thảo VI (DB + AI Gợi ý)" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                    <TextBlock Grid.Column="3" Text="Thao tác" Foreground="#858585" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <StackPanel x:Name="StackTemplateRows"/>
                            </ScrollViewer>
                            <Border Grid.Row="2" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Padding="20,10">
                                <Grid>
                                    <TextBlock x:Name="TxtTemplateStatus" Text="Hiển thị 0 kết quả" Foreground="#858585" FontSize="12" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnApplyAllTemplate" Click="BtnApplyAllTemplate_Click" Style="{StaticResource VsLightPrimaryBtn}" Height="30" Padding="20,0" HorizontalAlignment="Right" Content="Áp dụng tất cả"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- PANE 6: PROSE -->
                        <Grid x:Name="PaneProse" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#141416" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="340"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dòng" Foreground="#858585" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Gốc EN &amp; CSDL DB" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="Khung Soạn Thảo VI" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                    <TextBlock Grid.Column="3" Text="Thao tác" Foreground="#858585" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <StackPanel x:Name="StackProseRows"/>
                            </ScrollViewer>
                            <Border Grid.Row="2" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Padding="20,10">
                                <Grid>
                                    <TextBlock x:Name="TxtProseStatus" Text="Hiển thị 0 kết quả" Foreground="#858585" FontSize="12" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnApplyAllProse" Click="BtnApplyAllProse_Click" Style="{StaticResource VsLightPrimaryBtn}" Height="30" Padding="20,0" HorizontalAlignment="Right" Content="Áp dụng tất cả"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- PANE 7: AUTO -->
                        <Grid x:Name="PaneAuto" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Options Filter Bar -->
                            <Border Grid.Row="0" Background="#202225" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tùy chọn dịch tự động theo DB:" Foreground="#aaaaaa" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="ChkAutoDialogue" Content="💬 Hội thoại (Dialogue khớp 100% CSDL DB)" IsChecked="True" Foreground="#e2e8f0" FontSize="12" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkAutoHeader" Content="📌 Tiêu đề (Header ==...==)" IsChecked="True" Foreground="#e2e8f0" FontSize="12" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkAutoWikilinks" Content="🔗 Chuẩn hóa Wikilink" IsChecked="True" Foreground="#e2e8f0" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="#141416" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dòng" Foreground="#858585" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Thành Phần" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="Nội Dung Gốc" Foreground="#858585" FontSize="11.5" FontWeight="Bold" Margin="10,0"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <StackPanel x:Name="StackAutoRows"/>
                            </ScrollViewer>
                            <Border Grid.Row="3" Background="#18181c" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Padding="20,10">
                                <Grid>
                                    <TextBlock x:Name="TxtAutoStatus" Text="Sẵn sàng thực hiện dịch tự động" Foreground="#858585" FontSize="12" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnExecuteAuto" Click="BtnExecuteAuto_Click" Style="{StaticResource VsLightPrimaryBtn}" Height="30" Padding="20,0" HorizontalAlignment="Right" Content="Thực hiện dịch tự động"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
